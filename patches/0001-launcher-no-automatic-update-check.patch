@@ -0,0 +1,39 @@
+import { afterEach, describe, expect, it, vi } from "vitest";
+
+import { createLauncherUpdates } from "./createLauncherUpdates";
+
+const INSTALLED_VERSION = "3.2.0";
+const CACHE_KEY = "aerotizen.launcherUpdate.check";
+
+describe("createLauncherUpdates", () => {
+  afterEach(() => {
+    vi.unstubAllGlobals();
+    localStorage.clear();
+  });
+
+  it("does not request releases or advertise a cached upstream version", async () => {
+    const request = vi.fn();
+    vi.stubGlobal("XMLHttpRequest", request);
+    localStorage.setItem(CACHE_KEY, JSON.stringify({ latest: "999.0.0", attemptedAt: 1 }));
+    const updates = createLauncherUpdates(INSTALLED_VERSION);
+
+    await updates.check();
+
+    expect(request).not.toHaveBeenCalled();
+    expect(updates.getSnapshot()).toMatchObject({ check: "idle", latestVersion: null, unread: false });
+    updates.dispose();
+  });
+
+  it("reports a manual check as unavailable without making a request", () => {
+    const request = vi.fn();
+    vi.stubGlobal("XMLHttpRequest", request);
+    const updates = createLauncherUpdates(INSTALLED_VERSION);
+
+    updates.checkNow();
+
+    expect(request).not.toHaveBeenCalled();
+    expect(updates.getSnapshot().check).toBe("failed");
+    expect(localStorage.getItem(CACHE_KEY)).toBeNull();
+    updates.dispose();
+  });
+});
