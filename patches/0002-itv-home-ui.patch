diff --git a/launcher/src/itv/components/ItvHome/ItvHome.module.css b/launcher/src/itv/components/ItvHome/ItvHome.module.css
new file mode 100644
index 0000000..90c035e
--- /dev/null
+++ b/launcher/src/itv/components/ItvHome/ItvHome.module.css
@@ -0,0 +1,92 @@
+.home {
+  position: fixed;
+  top: 0;
+  left: 0;
+  width: 1920px;
+  height: 1080px;
+  overflow: hidden;
+  color: #fff;
+  font-family: var(--font-ui, "Google Sans", "Roboto", sans-serif);
+  background-color: #120f2e;
+}
+
+.content {
+  position: absolute;
+  top: 0;
+  left: 0;
+  width: 100%;
+  height: 100%;
+  transition: transform var(--motion-duration-scroll) cubic-bezier(0.2, 0.8, 0.2, 1);
+  /* Its own layer, so tile changes never invalidate the wallpaper underneath. */
+  will-change: transform;
+}
+
+/* One frosted plate behind all visible rows, without backdrop-filter: the wallpaper behind it is a static,
+   smooth gradient, so a live blur would cost the TV a pass on every tile animation for no visible difference.
+   Its size changes only when rows are revealed or hidden: growing happens below the screen edge before the grid
+   slides up, and shrinking waits until the grid has slid back down. */
+.plate {
+  position: absolute;
+  left: 75px;
+  width: 1770px;
+  border-radius: 40px;
+  background-color: rgba(255, 255, 255, 0.09);
+  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.15);
+}
+
+.plate[data-revealed="false"] {
+  transition:
+    top 0s linear var(--motion-duration-scroll),
+    height 0s linear var(--motion-duration-scroll);
+}
+
+.home[data-entering="true"] .plate {
+  animation: fade var(--motion-duration-itv-rise) ease both;
+}
+
+/* Opening an item fades the screen to black; a return fades the Home back in. Opacity only. */
+.curtain {
+  position: absolute;
+  top: 0;
+  left: 0;
+  z-index: 30;
+  width: 100%;
+  height: 100%;
+  background-color: #000;
+  opacity: 0;
+  pointer-events: none;
+  visibility: hidden;
+}
+
+.curtain[data-curtain="covering"],
+.curtain[data-curtain="covered"] {
+  opacity: 1;
+  visibility: visible;
+}
+
+.curtain[data-curtain="covering"] {
+  transition: opacity var(--motion-duration-itv-open) cubic-bezier(0.4, 0, 1, 1);
+}
+
+.curtain[data-curtain="revealing"] {
+  visibility: visible;
+  /* Long and gentle: most of the brightening happens early, then it settles slowly. */
+  transition: opacity var(--motion-duration-itv-reveal) cubic-bezier(0.25, 0.1, 0.25, 1);
+}
+
+/* Quick successive arrows: focus moves without animating, so presses never queue behind transitions. */
+.home[data-rapid="true"] .content {
+  transition-duration: 0s;
+}
+
+.grid {
+  position: absolute;
+  top: 0;
+  left: 105px;
+}
+
+@keyframes fade {
+  from {
+    opacity: 0;
+  }
+}
diff --git a/launcher/src/itv/components/ItvHome/ItvHome.tsx b/launcher/src/itv/components/ItvHome/ItvHome.tsx
new file mode 100644
index 0000000..a0f914d
--- /dev/null
+++ b/launcher/src/itv/components/ItvHome/ItvHome.tsx
@@ -0,0 +1,141 @@
+import { useMemo } from "preact/hooks";
+
+import type { AppsService } from "../../../contracts/apps";
+import { useStore } from "../../../shared/hooks/useStore";
+import type { WallpaperName } from "../../config";
+import { COPY } from "../../copy";
+import { LAYOUT } from "../../layout";
+import type { BrandLookup } from "../../model/brands";
+import { BRAND_NAMES } from "../../model/brands";
+import type { Cell, Tile as TileModel } from "../../model/tiles";
+import { APPS_KEY, APPS_TILE, appsCell, gridCell, rowCount } from "../../model/tiles";
+import type { ItvHomeController } from "../../state/createItvHomeController";
+import { MENU_CHOICES, MENU_LABELS, VISIBLE_ROWS } from "../../state/createItvHomeController";
+import { MoveHint } from "../MoveHint/MoveHint";
+import { createFocusShadow } from "../Tile/createFocusShadow";
+import { Tile } from "../Tile/Tile";
+import { TileMenu } from "../TileMenu/TileMenu";
+import { Wallpaper } from "../Wallpaper/Wallpaper";
+
+import styles from "./ItvHome.module.css";
+
+export interface ItvHomeProps {
+  readonly apps: Pick<AppsService, "byId" | "getSnapshot" | "subscribe">;
+  readonly brands: BrandLookup;
+  readonly bumpMs: number;
+  readonly controller: ItvHomeController;
+  readonly document: Document;
+  readonly wallpaper: WallpaperName;
+}
+
+const MENU_LABEL_LIST = MENU_CHOICES.map((choice) => MENU_LABELS[choice]);
+
+// Tiles keep a fixed DOM order and are placed only by transform. Reordering DOM nodes during a move would
+// restart their animations and recreate their compositing layers; with a fixed order the tiles just slide.
+const byKey = (left: { tile: TileModel }, right: { tile: TileModel }) => (left.tile.key < right.tile.key ? -1 : 1);
+
+const cellX = (cell: Cell) => cell.column * LAYOUT.columnPitchPx;
+const cellY = (cell: Cell) => cell.row * LAYOUT.rowPitchPx;
+
+// The menu opens above its tile, over the free wallpaper area, so it never covers other tiles; below only when
+// there is no room above.
+const menuPosition = (cell: Cell, offsetY: number) => {
+  const left = LAYOUT.gridLeftPx + cellX(cell) - (284 - LAYOUT.tileWidthPx) / 2;
+  const top = offsetY + cellY(cell);
+  const above = top - LAYOUT.menuHeightPx - LAYOUT.menuGapPx;
+  return {
+    x: Math.min(Math.round(left), LAYOUT.stageWidthPx - LAYOUT.menuWidthPx - LAYOUT.stageMarginPx),
+    y: above >= LAYOUT.stageMarginPx ? above : top + LAYOUT.tileHeightPx + LAYOUT.menuGapPx,
+  };
+};
+
+export const ItvHome = ({ apps, brands, bumpMs, controller, document, wallpaper }: ItvHomeProps) => {
+  const state = useStore(controller);
+  const focusShadow = useMemo(() => createFocusShadow(document), [document]);
+  useStore(apps);
+  const describe = (tile: TileModel) => {
+    const app = tile.appId ? apps.byId(tile.appId) : null;
+    const brand = app ? brands.brandOf(app) : null;
+    if (tile.kind === "ps4") {
+      return { app, brand, label: COPY.ps4 };
+    }
+    if (tile.kind === "apps") {
+      return { app, brand, label: COPY.apps };
+    }
+    return { app, brand, label: brand ? BRAND_NAMES[brand] : app?.name || tile.appId || "" };
+  };
+  const gridCount = state.tiles.length;
+  // The Apps tile waits hidden in its own row below the grid; Down from the last row reveals it.
+  const revealed = state.focus === APPS_KEY || gridCount === 0;
+  const lastRow = revealed ? rowCount(gridCount) : Math.min(rowCount(gridCount), state.firstRow + VISIBLE_ROWS) - 1;
+  const firstRow = Math.min(state.firstRow, lastRow);
+  // The grid slides so its lowest visible row sits at the bottom of the screen.
+  const offsetY = LAYOUT.bottomRowTopPx - lastRow * LAYOUT.rowPitchPx;
+  const entries = [
+    ...state.tiles.map((tile, index) => ({ tile, index, cell: gridCell(index) })),
+    { tile: APPS_TILE, index: gridCount, cell: appsCell(gridCount) },
+  ];
+  const menuEntry = state.menu ? entries.find((entry) => entry.tile.key === state.menu?.key) : undefined;
+  const menuAt = menuEntry ? menuPosition(menuEntry.cell, offsetY) : null;
+  const menuTile = menuEntry?.tile ?? null;
+  return (
+    <div
+      class={styles.home}
+      data-home-content
+      data-itv-home
+      data-entering={state.entering ? "true" : "false"}
+      data-rapid={state.rapid ? "true" : "false"}
+      data-curtain-phase={state.curtain}
+      style={focusShadow ? { "--itv-focus-shadow": "url(" + focusShadow + ")" } : undefined}
+      aria-hidden={!state.active}
+    >
+      <Wallpaper name={wallpaper} document={document} />
+      <main class={styles.content} aria-label={COPY.homeLabel} style={{ transform: `translateY(${offsetY}px)` }}>
+        {/* One continuous frosted plate behind every visible row, the revealed Apps row included. */}
+        <div
+          class={styles.plate}
+          data-revealed={revealed ? "true" : "false"}
+          style={{
+            top: firstRow * LAYOUT.rowPitchPx - LAYOUT.platePaddingPx + "px",
+            height: (lastRow - firstRow) * LAYOUT.rowPitchPx + LAYOUT.tileHeightPx + 2 * LAYOUT.platePaddingPx + "px",
+          }}
+        />
+        <div class={styles.grid}>
+          {[...entries].sort(byKey).map(({ tile, index, cell }) => {
+            const { app, brand, label } = describe(tile);
+            return (
+              <Tile
+                key={tile.key}
+                app={app}
+                brand={brand}
+                bump={state.bump?.key === tile.key ? state.bump : null}
+                bumpMs={bumpMs}
+                focused={state.focus === tile.key}
+                launching={state.launching === tile.key}
+                index={index}
+                label={label}
+                moving={state.moving === tile.key}
+                outside={cell.row < firstRow || cell.row > lastRow}
+                sheen={state.sheen === tile.key}
+                tile={tile}
+                x={cellX(cell)}
+                y={cellY(cell)}
+              />
+            );
+          })}
+        </div>
+      </main>
+      {state.menu && menuAt && menuTile && (
+        <TileMenu
+          choices={MENU_LABEL_LIST}
+          label={COPY.appActions(describe(menuTile).label)}
+          selected={state.menu.selected}
+          x={menuAt.x}
+          y={menuAt.y}
+        />
+      )}
+      <MoveHint visible={state.moving !== null} />
+      <div class={styles.curtain} data-curtain={state.curtain} aria-hidden="true" />
+    </div>
+  );
+};
