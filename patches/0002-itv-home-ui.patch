+// Grid geometry on the 1920×1080 stage. The grid is anchored at the bottom: the lowest visible row sits
+// 60 px above the screen edge and rows grow upwards, leaving the upper area to the wallpaper.
+export const LAYOUT = {
+  gridLeftPx: 105,
+  // Top of the lowest visible row: 1080 - 60 px margin - 150 px tile.
+  bottomRowTopPx: 870,
+  columnPitchPx: 292,
+  rowPitchPx: 236,
+  tileWidthPx: 250,
+  tileHeightPx: 150,
+  // The frosted plate reaches this far around the visible rows.
+  platePaddingPx: 30,
+  menuWidthPx: 300,
+  menuGapPx: 28,
+  menuHeightPx: 170,
+  stageWidthPx: 1920,
+  stageHeightPx: 1080,
+  stageMarginPx: 30,
+} as const;
+
+// Tiles that rise in turn at power-on: the two visible rows. Later tiles share the last delay,
+// so the whole entrance stays about 0.4 s.
+export const ENTRANCE_COHORT = 12;
