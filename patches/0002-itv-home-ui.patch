+import { describe, expect, test } from "vitest";
+
+import { appCatalog } from "../../shared/apps/appCatalog";
+
+import { createBrandLookup } from "./brands";
+import { EMPTY_LIBRARY, hideApp, parseLibrary, reconcileLibrary, serializeLibrary, setLastUsed } from "./library";
+import { findPs4 } from "./ps4";
+import { appsCell, buildTiles, gridCell, neighbour, swapApps } from "./tiles";
+
+const brands = createBrandLookup(appCatalog);
+const rank = (names: Record<string, string>) => (id: string) => brands.defaultRank({ id, name: names[id] || id });
+
+describe("brands", () => {
+  test("recognises the six apps by catalogue identity and by name", () => {
+    expect(brands.brandOf({ id: "org.tizen.netflix-app" })).toBe("netflix");
+    expect(brands.brandOf({ id: "3201907018807" })).toBe("netflix");
+    expect(brands.brandOf({ id: "fjpfQryJuR.HBOMaxCTV" })).toBe("hbomax");
+    expect(brands.brandOf({ id: "x", name: "Spotify - Music and Podcasts" })).toBe("spotify");
+    expect(brands.brandOf({ id: "y", name: "Max" })).toBe("hbomax");
+    expect(brands.brandOf({ id: "z", name: "YouTube Kids" })).toBeNull();
+  });
+});
+
+describe("library", () => {
+  const names = { n: "Netflix", s: "Spotify", y: "YouTube", d: "Disney+", h: "HBO Max", p: "Prime Video" };
+
+  test("the first discovery orders the six apps and treats everything else as pre-installed", () => {
+    const library = reconcileLibrary(EMPTY_LIBRARY, ["p", "tvplus", "y", "n", "h", "d", "s"], rank(names));
+    expect(library.initialized).toBe(true);
+    expect(library.order).toEqual(["n", "s", "y", "d", "h", "p"]);
+    expect(library.known).toContain("tvplus");
+  });
+
+  test("later discoveries append new apps, never pre-installed or hidden ones", () => {
+    const first = reconcileLibrary(EMPTY_LIBRARY, ["n", "tvplus"], rank(names));
+    const hidden = hideApp(reconcileLibrary(first, ["n", "tvplus", "globo"], rank(names)), "globo");
+    const next = reconcileLibrary(hidden, ["n", "tvplus", "globo", "twitch"], rank(names));
+    expect(next.order).toEqual(["n", "twitch"]);
+    expect(reconcileLibrary(next, ["n", "tvplus", "globo", "twitch"], rank(names))).toBe(next);
+  });
+
+  test("an uninstalled app keeps its place for a reinstall", () => {
+    const library = reconcileLibrary(EMPTY_LIBRARY, ["n", "s", "y"], rank(names));
+    expect(reconcileLibrary(library, ["n", "y"], rank(names)).order).toEqual(["n", "s", "y"]);
+  });
+
+  test("storage round-trips and rejects invalid data", () => {
+    const library = setLastUsed(reconcileLibrary(EMPTY_LIBRARY, ["n"], rank(names)), "app:n");
+    expect(parseLibrary(serializeLibrary(library))).toEqual(library);
+    expect(parseLibrary("{bad")).toBe(EMPTY_LIBRARY);
+    expect(parseLibrary(JSON.stringify({ order: [1, "a", "a"], initialized: "yes" }))).toMatchObject({
+      initialized: false,
+      order: ["a"],
+    });
+  });
+
+  test("hiding the last-used app clears it", () => {
+    const library = setLastUsed(reconcileLibrary(EMPTY_LIBRARY, ["n"], rank(names)), "app:n");
+    expect(hideApp(library, "n")).toMatchObject({ hidden: ["n"], lastUsed: null, order: [] });
+  });
+});
+
+describe("tiles", () => {
+  test("the grid holds the apps, then the PS4 while connected; Apps waits in its own row below", () => {
+    expect(buildTiles(["a"], true).map((tile) => tile.key)).toEqual(["app:a", "ps4"]);
+    expect(buildTiles(["a"], false).map((tile) => tile.key)).toEqual(["app:a"]);
+    expect(appsCell(6)).toEqual({ row: 1, column: 0 });
+    expect(appsCell(7)).toEqual({ row: 2, column: 0 });
+    expect(gridCell(7)).toEqual({ row: 1, column: 1 });
+  });
+
+  test("focus stops at the row ends and keeps its column between rows", () => {
+    expect(neighbour(9, 0, "left")).toBeNull();
+    expect(neighbour(9, 5, "right")).toBeNull();
+    expect(neighbour(9, 8, "right")).toBeNull();
+    expect(neighbour(9, 0, "up")).toBeNull();
+    expect(neighbour(9, 1, "down")).toBe(7);
+    expect(neighbour(9, 5, "down")).toBe(8);
+    expect(neighbour(9, 8, "up")).toBe(2);
+    expect(neighbour(9, 6, "down")).toBeNull();
+  });
+
+  test("moving swaps two apps in the saved order", () => {
+    expect(swapApps(["a", "gone", "b", "c"], "a", "c")).toEqual(["c", "gone", "b", "a"]);
+    expect(swapApps(["a"], "a", "missing")).toEqual(["a"]);
+  });
+});
+
+describe("PS4", () => {
+  const sources = (editName: string, connected: boolean, number = 1) => [{ type: "HDMI", number, editName, connected }];
+
+  test("needs a PS4 name, or the configured port, and a connection", () => {
+    expect(findPs4(sources("PS4", true), { fixedPort: null })).not.toBeNull();
+    expect(findPs4(sources("PlayStation 4", true), { fixedPort: null })).not.toBeNull();
+    expect(findPs4(sources("PS4", false), { fixedPort: null })).toBeNull();
+    expect(findPs4(sources("PlayStation 5", true), { fixedPort: null })).toBeNull();
+    expect(findPs4(sources("PS5", true), { fixedPort: null })).toBeNull();
+    expect(findPs4(sources("HDMI 2", true, 2), { fixedPort: 2 })).not.toBeNull();
+    expect(findPs4(sources("HDMI 2", false, 2), { fixedPort: 2 })).toBeNull();
+  });
+});
