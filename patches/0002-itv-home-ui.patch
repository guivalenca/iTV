+import type { InstalledApp } from "../../../contracts/launcher";
+import { COPY } from "../../copy";
+import disney from "../../logos/disney.svg";
+import hbomax from "../../logos/hbomax.svg";
+import netflix from "../../logos/netflix.svg";
+import playstation from "../../logos/playstation.svg";
+import prime from "../../logos/prime.svg";
+import spotify from "../../logos/spotify.svg";
+import youtube from "../../logos/youtube.svg";
+import type { Brand } from "../../model/brands";
+import type { TileKind } from "../../model/tiles";
+
+import { AppsSymbol } from "./AppsSymbol";
+import { InstalledAppArt } from "./InstalledAppArt";
+import styles from "./TileArtwork.module.css";
+
+const LOGOS: Readonly<Record<Brand, string>> = { disney, hbomax, netflix, prime, spotify, youtube };
+
+export interface TileArtworkProps {
+  readonly app: InstalledApp | null;
+  readonly brand: Brand | null;
+  readonly kind: TileKind;
+}
+
+export const TileArtwork = ({ app, brand, kind }: TileArtworkProps) => {
+  if (kind === "apps") {
+    return (
+      <div class={styles.art} data-art="apps">
+        <AppsSymbol />
+        <span class={styles.appsText}>{COPY.apps}</span>
+      </div>
+    );
+  }
+  if (kind === "ps4") {
+    return (
+      <div class={styles.art} data-art="ps4">
+        <img class={styles.playstation} src={playstation} alt="" draggable={false} />
+        <span class={styles.ps4Text}>{COPY.ps4}</span>
+      </div>
+    );
+  }
+  if (brand) {
+    return (
+      <div class={styles.art} data-art={brand}>
+        <img class={styles.logo} data-logo={brand} src={LOGOS[brand]} alt="" draggable={false} />
+      </div>
+    );
+  }
+  return <InstalledAppArt app={app} />;
+};
