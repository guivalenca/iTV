+// The Home's UI text. It is always English, whatever the TV language.
+export const COPY = {
+  homeLabel: "Home",
+  move: "Move",
+  hide: "Hide",
+  appActions: (name: string) => name + " options",
+  moving: "Moving — arrows to move · OK to place · Back to cancel",
+  hidden: (name: string) => name + " hidden",
+  fixedPlace: (name: string) => name + " has a fixed place",
+  openFailed: (name: string) => "Couldn’t open " + name,
+  ps4: "PS4",
+  apps: "Apps",
+  soundsItv: "Sounds: iTV",
+  soundsSamsung: "Sounds: Samsung",
+  soundsSamsungUnavailable: "Samsung sounds are unavailable on this TV",
+} as const;
diff --git a/launcher/src/itv/index.tsx b/launcher/src/itv/index.tsx
new file mode 100644
index 0000000..8059735
--- /dev/null
+++ b/launcher/src/itv/index.tsx
@@ -0,0 +1,269 @@
+import { render } from "preact";
+import { flushSync } from "preact/compat";
+
+import type { HomeBridge } from "../contracts/launcher";
+import type { SettingsStore } from "../contracts/preferences";
+import type { LauncherRuntime } from "../platform/tizen/launcherRuntime";
+import { appCatalog } from "../shared/apps/appCatalog";
+import { createInputScope } from "../shared/input/createInputScope";
+
+import { ItvHome } from "./components/ItvHome/ItvHome";
+import { ITV_CONFIG } from "./config";
+import { COPY } from "./copy";
+import { ENTRANCE_COHORT } from "./layout";
+import { createBrandLookup } from "./model/brands";
+import type { RunningAppsTizen } from "./platform/createRunningApps";
+import { createRunningApps } from "./platform/createRunningApps";
+import type { ItvSound } from "./sounds/createItvSounds";
+import { createItvSounds } from "./sounds/createItvSounds";
+import type { TvAudioTizen } from "./sounds/createSamsungSounds";
+import { createSamsungSounds } from "./sounds/createSamsungSounds";
+import { createInputTimings } from "./state/createInputTimings";
+import { createItvHomeController } from "./state/createItvHomeController";
+
+const MAIN_OPERATION = "http://tizen.org/appcontrol/operation/main";
+const HANDLED_ACTIONS = ["left", "right", "up", "down", "confirm", "back"];
+const MS_PER_SECOND = 1000;
+// After Home is pressed, the TV runs its own ~0.5 s black transition while the page already reports itself
+// visible. The fade back in waits this long, so it plays on screen instead of during the TV's black.
+const RETURN_REVEAL_DELAY_MS = 450;
+
+type AppControlTizen = {
+  application?: {
+    getCurrentApplication?(): { getRequestedAppControl(): { appControl?: { operation?: string } } | null };
+  };
+};
+
+// Motion tokens are seconds in CSS; performance mode and reduced motion set them to zero.
+const motionMs = (document: Document, token: string) => {
+  const value = parseFloat(
+    document.defaultView?.getComputedStyle(document.documentElement).getPropertyValue(token) || "",
+  );
+  return Number.isFinite(value) ? value * MS_PER_SECOND : 0;
+};
+
+const isMainRequest = (tizen: AppControlTizen | null | undefined) => {
+  try {
+    const operation = tizen?.application?.getCurrentApplication?.().getRequestedAppControl()?.appControl?.operation;
+    return operation === undefined || operation === MAIN_OPERATION;
+  } catch {
+    return true;
+  }
+};
+
+// The iTV Home: same view contract as the AeroTizen Home, so app composition, input routing and boot are unchanged.
+export const mountItvHome = (
+  runtime: LauncherRuntime,
+  settings: SettingsStore,
+  mount: HTMLElement,
+): { bridge: HomeBridge; dispose(): void } => {
+  const document = mount.ownerDocument;
+  const window = document.defaultView;
+  const html = document.documentElement;
+  const syncPerformance = () => {
+    html.setAttribute("data-performance-mode", String(settings.getSnapshot().performanceMode));
+  };
+  syncPerformance();
+  const unsubscribeSettings = settings.subscribe(syncPerformance);
+  const sounds = createItvSounds(window || {});
+  const samsungSounds = createSamsungSounds(runtime.tizen as TvAudioTizen | null | undefined);
+  // Every start uses the approved iTV sounds; the Samsung beeps last only until the launcher restarts.
+  let useSamsungSounds = false;
+  const player = {
+    markInput: sounds.markInput,
+    prepare: sounds.prepare,
+    play(sound: ItvSound) {
+      if (useSamsungSounds) {
+        samsungSounds.play(sound);
+      } else {
+        sounds.play(sound);
+      }
+    },
+  };
+  const toggleSounds = () => {
+    if (!samsungSounds.available) {
+      runtime.toast(COPY.soundsSamsungUnavailable);
+      return;
+    }
+    useSamsungSounds = !useSamsungSounds;
+    runtime.toast(useSamsungSounds ? COPY.soundsSamsung : COPY.soundsItv);
+    player.play("select");
+  };
+  const brands = createBrandLookup(appCatalog);
+  const running = createRunningApps(runtime.tizen as RunningAppsTizen | null | undefined);
+  const controller = createItvHomeController({
+    apps: runtime.apps,
+    brands,
+    entranceMs:
+      motionMs(document, "--motion-duration-itv-rise") +
+      (ENTRANCE_COHORT - 1) * motionMs(document, "--motion-duration-itv-stagger"),
+    inputs: runtime.inputs,
+    longPressMs: runtime.config.LONG_PRESS_MS,
+    now: () => performance.now(),
+    openMs: motionMs(document, "--motion-duration-itv-open"),
+    revealMs: motionMs(document, "--motion-duration-itv-reveal"),
+    ps4: { fixedPort: ITV_CONFIG.ps4FixedPort },
+    sounds: player,
+    onBackHold: toggleSounds,
+    storage: {
+      getItem: (key) => localStorage.getItem(key),
+      setItem: (key, value) => localStorage.setItem(key, value),
+    },
+    timers: window || globalThis,
+    toast: (message) => runtime.toast(message),
+  });
+  const timings = createInputTimings(window);
+  const inputScope = createInputScope({
+    onCancel: controller.cancelPress,
+    handle(event) {
+      if (!HANDLED_ACTIONS.includes(event.action)) {
+        return "unhandled";
+      }
+      timings.measure(event.action + ":" + event.phase, (event.nativeEvent as { timeStamp?: number }).timeStamp, () =>
+        flushSync(() => controller.handle(event, () => inputScope.cancel())),
+      );
+      return "handled";
+    },
+  });
+  // Visibility and Home requests can arrive together; act on them once.
+  let returnTimer: number | undefined;
+  let revealTimer: number | undefined;
+  const returnHome = () => {
+    if (
+      returnTimer !== undefined ||
+      revealTimer !== undefined ||
+      document.hidden ||
+      runtime.inputs.getSnapshot().playback === "playing"
+    ) {
+      return;
+    }
+    returnTimer = window?.setTimeout(() => {
+      returnTimer = undefined;
+      if (document.hidden) {
+        return;
+      }
+      const launched = controller.takeLaunched();
+      sounds.prepare();
+      // Start the fade back in only once the TV shows the page again (see RETURN_REVEAL_DELAY_MS); starting
+      // earlier lets the fade finish unseen and the Home appears all at once.
+      const start = () => {
+        if (document.hidden) {
+          return;
+        }
+        controller.returnHome();
+        const mark = controller.navigationMark();
+        running.observeReturn(controller.gridIds, launched, (id) => controller.observeOpened(id, mark));
+      };
+      if (window) {
+        revealTimer = window.setTimeout(() => {
+          revealTimer = undefined;
+          window.requestAnimationFrame(() => window.requestAnimationFrame(start));
+        }, RETURN_REVEAL_DELAY_MS);
+      } else {
+        start();
+      }
+    }, 0);
+  };
+  const leave = () => {
+    if (revealTimer !== undefined) {
+      window?.clearTimeout(revealTimer);
+      revealTimer = undefined;
+    }
+    running.cancel();
+    controller.leave();
+    sounds.pause();
+  };
+  // Key-to-sound measurements for the next TV test: `aerotizen inspect launcher`, then itvAudio.report().
+  const debugHost = window as
+    | (Window & {
+        itvAudio?: { report: typeof sounds.report };
+        itvPerf?: { presented: typeof timings.presented; report: typeof timings.report };
+      })
+    | null;
+  if (debugHost) {
+    debugHost.itvAudio = { report: sounds.report };
+    debugHost.itvPerf = { report: timings.report, presented: timings.presented };
+  }
+  const onVisibility = () => (document.hidden ? leave() : returnHome());
+  // Native Home relaunches the launcher with a main app control when Home is pressed, including on the Home.
+  const onAppControl = () => {
+    if (isMainRequest(runtime.tizen)) {
+      returnHome();
+    }
+  };
+  // Embedded HDMI playback hides the Home ([data-home-content]); coming back from it is a return too.
+  let playback = runtime.inputs.getSnapshot().playback;
+  const onInputs = () => {
+    const next = runtime.inputs.getSnapshot().playback;
+    if (next === playback) {
+      return;
+    }
+    const previous = playback;
+    playback = next;
+    if (next === "playing") {
+      leave();
+    } else if (next === "idle" && previous === "playing") {
+      returnHome();
+    }
+  };
+  document.addEventListener("visibilitychange", onVisibility);
+  window?.addEventListener("appcontrol", onAppControl);
+  const unsubscribeInputs = runtime.inputs.subscribe(onInputs);
+  // Wake the audio output now rather than on the first key press.
+  sounds.prepare();
+  // The first look at running apps is the baseline for the next return.
+  running.observeReturn(controller.gridIds, null, () => undefined);
+  const bridge: HomeBridge = {
+    inputScope,
+    cancelInput: controller.cancelPress,
+    // Ordinary refreshes keep the current selection; returns are handled above.
+    focus: controller.refresh,
+    blur: leave,
+    render: controller.refresh,
+    buildRows: controller.refresh,
+    refreshApps: controller.refresh,
+    keydown() {},
+    keyup() {},
+  };
+  const dispose = () => {
+    document.removeEventListener("visibilitychange", onVisibility);
+    window?.removeEventListener("appcontrol", onAppControl);
+    unsubscribeInputs();
+    unsubscribeSettings();
+    if (returnTimer !== undefined) {
+      window?.clearTimeout(returnTimer);
+    }
+    if (revealTimer !== undefined) {
+      window?.clearTimeout(revealTimer);
+    }
+    running.cancel();
+    timings.dispose();
+    controller.dispose();
+    if (debugHost?.itvPerf?.report === timings.report) {
+      delete debugHost.itvPerf;
+    }
+    if (debugHost?.itvAudio?.report === sounds.report) {
+      delete debugHost.itvAudio;
+    }
+    sounds.dispose();
+    render(null, mount);
+    html.removeAttribute("data-performance-mode");
+  };
+  try {
+    render(
+      <ItvHome
+        apps={runtime.apps}
+        brands={brands}
+        bumpMs={motionMs(document, "--motion-duration-itv-bump")}
+        controller={controller}
+        document={document}
+        wallpaper={ITV_CONFIG.wallpaper}
+      />,
+      mount,
+    );
+    return { bridge, dispose };
+  } catch (error) {
+    dispose();
+    throw error;
+  }
+};
