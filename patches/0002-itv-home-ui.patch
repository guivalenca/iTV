@@ -0,0 +1,18 @@
+import type { InputSource } from "../../contracts/launcher";
+
+// HDMI-CEC names a PS4 may announce ("PS4", "PS4 Pro", "PlayStation 4", "PlayStation"). A PS5 must not match.
+const PS4_NAME = /^(?:ps\s?4|play\s?station(?:\s?4)?)(?:\s?pro)?$/i;
+
+export interface Ps4Identity {
+  // HDMI port that identifies the console when it announces no usable name. It does not imply a connection.
+  readonly fixedPort: number | null;
+}
+
+export const isPs4 = (source: InputSource, { fixedPort }: Ps4Identity) =>
+  source.type === "HDMI" &&
+  (PS4_NAME.test((source.editName || "").trim()) || (fixedPort !== null && source.number === fixedPort));
+
+// The PS4 tile exists only while the console's HDMI source reports a connection.
+// Read every source, not the AeroTizen-visible list, so its HDMI preferences cannot hide the console.
+export const findPs4 = (sources: readonly InputSource[], identity: Ps4Identity): InputSource | null =>
+  sources.find((source) => source.connected === true && isPs4(source, identity)) ?? null;
diff --git a/launcher/src/itv/model/tiles.ts b/launcher/src/itv/model/tiles.ts
new file mode 100644
index 0000000..276247d
--- /dev/null
+++ b/launcher/src/itv/model/tiles.ts
@@ -0,0 +1,78 @@
+// Grid model: which tiles exist, where they sit and where each arrow leads. Pure functions only.
+
+export const GRID_COLUMNS = 6;
+
+export const PS4_KEY = "ps4";
+export const APPS_KEY = "apps";
+const APP_PREFIX = "app:";
+
+export type TileKind = "app" | "ps4" | "apps";
+export type Direction = "left" | "right" | "up" | "down";
+
+export interface Tile {
+  readonly appId?: string;
+  readonly key: string;
+  readonly kind: TileKind;
+}
+
+export const APPS_TILE: Tile = Object.freeze({ key: APPS_KEY, kind: "apps" });
+const PS4_TILE: Tile = Object.freeze({ key: PS4_KEY, kind: "ps4" });
+
+export const appKey = (id: string) => APP_PREFIX + id;
+export const appIdOf = (key: string) => (key.startsWith(APP_PREFIX) ? key.slice(APP_PREFIX.length) : null);
+
+// The grid: user apps, then the PS4 while it is connected. The Apps tile is not part of it: it waits hidden
+// in its own row below the grid (see appsCell).
+export const buildTiles = (appIds: readonly string[], ps4Connected: boolean): readonly Tile[] =>
+  Object.freeze([
+    ...appIds.map((id) => Object.freeze<Tile>({ key: appKey(id), kind: "app", appId: id })),
+    ...(ps4Connected ? [PS4_TILE] : []),
+  ]);
+
+export const rowCount = (count: number) => Math.ceil(count / GRID_COLUMNS);
+
+export interface Cell {
+  readonly column: number;
+  readonly row: number;
+}
+
+export const gridCell = (index: number): Cell => ({
+  row: Math.floor(index / GRID_COLUMNS),
+  column: index % GRID_COLUMNS,
+});
+
+// The Apps tile sits alone in the first column of the row after the grid.
+export const appsCell = (gridCount: number): Cell => ({ row: rowCount(gridCount), column: 0 });
+
+// Focus stops at the ends of a row and at the top and bottom rows; null means the edge was reached.
+export const neighbour = (count: number, index: number, direction: Direction): number | null => {
+  const row = Math.floor(index / GRID_COLUMNS);
+  const column = index % GRID_COLUMNS;
+  if (direction === "left") {
+    return column > 0 ? index - 1 : null;
+  }
+  if (direction === "right") {
+    return column < GRID_COLUMNS - 1 && index + 1 < count ? index + 1 : null;
+  }
+  const target = row + (direction === "down" ? 1 : -1);
+  if (target < 0 || target >= rowCount(count)) {
+    return null;
+  }
+  const lastInRow = Math.min(count, (target + 1) * GRID_COLUMNS) - 1;
+  return Math.min(target * GRID_COLUMNS + column, lastInRow);
+};
+
+// Swap two apps in the saved order. Apps missing from the order are left untouched.
+export const swapApps = (order: readonly string[], first: string, second: string): readonly string[] => {
+  const from = order.indexOf(first);
+  const to = order.indexOf(second);
+  if (from < 0 || to < 0) {
+    return order;
+  }
+  return order.map((id, index) => {
+    if (index === from) {
+      return second;
+    }
+    return index === to ? first : id;
+  });
+};
