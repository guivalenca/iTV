+import { useState } from "preact/hooks";
+
+import type { InstalledApp } from "../../../contracts/launcher";
+import { shortAppName } from "../../../shared/apps/appNames";
+
+import styles from "./TileArtwork.module.css";
+
+// An app installed later: its own TV icon on a frosted tile. Without an icon, its short name is the
+// artwork, so similar apps stay distinguishable (there are no labels under tiles).
+export const InstalledAppArt = ({ app }: { app: InstalledApp | null }) => {
+  const [failed, setFailed] = useState(false);
+  const icon = app?.icon && !failed ? app.icon : "";
+  if (!icon) {
+    return (
+      <div class={styles.art} data-art="app">
+        <span class={styles.appName}>{shortAppName(app?.name || "")}</span>
+      </div>
+    );
+  }
+  return (
+    <div class={styles.art} data-art="app">
+      <div class={styles.appIcon}>
+        <img class={styles.appIconImage} src={icon} alt="" draggable={false} onError={() => setFailed(true)} />
+      </div>
+    </div>
+  );
+};
