@@ -0,0 +1,69 @@
+import type { InstalledApp } from "../../contracts/launcher";
+import type { AppCatalog } from "../../shared/apps/appCatalog";
+
+// The six apps with official artwork, in the Home's initial order.
+export const BRANDS = ["netflix", "spotify", "youtube", "disney", "hbomax", "prime"] as const;
+export type Brand = (typeof BRANDS)[number];
+
+export const BRAND_NAMES: Readonly<Record<Brand, string>> = {
+  netflix: "Netflix",
+  spotify: "Spotify",
+  youtube: "YouTube",
+  disney: "Disney+",
+  hbomax: "HBO Max",
+  prime: "Prime Video",
+};
+
+// App catalogue entries for each brand. Store IDs identify every regional variant.
+const CATALOGUE_KEYS: Readonly<Record<string, Brand>> = {
+  netflix: "netflix",
+  spotify: "spotify",
+  youtube: "youtube",
+  disney: "disney",
+  max: "hbomax",
+  "prime-video": "prime",
+};
+
+// Name fallback for variants the catalogue does not list yet.
+const NAME_RULES: readonly { readonly brand: Brand; readonly pattern: RegExp }[] = [
+  { brand: "netflix", pattern: /^netflix\b/i },
+  { brand: "spotify", pattern: /^spotify\b/i },
+  { brand: "youtube", pattern: /^youtube$/i },
+  { brand: "disney", pattern: /^disney\s*\+|^disney plus\b/i },
+  { brand: "hbomax", pattern: /^(hbo\s*)?max$|^hbo max\b/i },
+  { brand: "prime", pattern: /prime video/i },
+];
+
+export const createBrandLookup = (catalog: Pick<AppCatalog, "apps" | "storeId">) => {
+  const byStoreId = new Map<string, Brand>();
+  for (const entry of catalog.apps) {
+    const brand = CATALOGUE_KEYS[entry.key];
+    if (!brand) {
+      continue;
+    }
+    for (const variant of entry.variants) {
+      byStoreId.set(variant.appId, brand);
+      if (variant.storeId) {
+        byStoreId.set(variant.storeId, brand);
+      }
+    }
+  }
+  const brandOf = (app: Pick<InstalledApp, "id"> & Partial<Pick<InstalledApp, "name">>): Brand | null => {
+    const known = byStoreId.get(app.id) ?? byStoreId.get(catalog.storeId(app.id) || "");
+    if (known) {
+      return known;
+    }
+    const name = (app.name || "").trim();
+    return NAME_RULES.find((rule) => rule.pattern.test(name))?.brand ?? null;
+  };
+  return {
+    brandOf,
+    // Position in the initial row, or -1 for apps outside the six.
+    defaultRank(app: Pick<InstalledApp, "id"> & Partial<Pick<InstalledApp, "name">>) {
+      const brand = brandOf(app);
+      return brand ? BRANDS.indexOf(brand) : -1;
+    },
+  };
+};
+
+export type BrandLookup = ReturnType<typeof createBrandLookup>;
