diff --git a/tests/browser/itv_home.spec.cjs b/tests/browser/itv_home.spec.cjs
new file mode 100644
index 0000000..26569bf
--- /dev/null
+++ b/tests/browser/itv_home.spec.cjs
@@ -0,0 +1,166 @@
+const { test, expect } = require("./launcher_fixture.cjs");
+
+const APPS = [
+  ["org.tizen.primevideo", "Prime Video"],
+  ["org.tizen.netflix-app", "Netflix"],
+  ["rJeHak5zRg.Spotify", "Spotify - Music and Podcasts"],
+  ["9Ur5IzDKqV.TizenYouTube", "YouTube"],
+  ["MCmYXNxgcu.DisneyPlus", "Disney+"],
+  ["fjpfQryJuR.HBOMaxCTV", "HBO Max"],
+  ["Pre0000001.TVPlus", "Samsung TV Plus"],
+];
+
+// Replace the shared preview inventory with the six chosen apps, one pre-installed app and a PS4.
+const installInventory = (page, { apps = APPS, ps4 = true, failLaunch = false } = {}) =>
+  page.addInitScript(
+    ({ apps, ps4, failLaunch }) => {
+      window.itvLaunches = [];
+      window.AeroTizen = window.AeroTizen || {};
+      window.AeroTizen.platforms = {
+        apps: (platform) => ({
+          ...platform,
+          cacheInventory: false,
+          readInstalled(done) {
+            done(apps.map(([id, name]) => ({ id, name, iconPath: "", packageId: id.slice(0, 10) })));
+            return () => undefined;
+          },
+          launch(app, refresh, reportFailure) {
+            window.itvLaunches.push(app.id);
+            if (failLaunch && reportFailure) {
+              reportFailure();
+            }
+          },
+        }),
+        inputs: (platform) => ({
+          ...platform,
+          read(done) {
+            done([
+              { type: "HDMI", number: 1, editName: "PS4", connected: ps4 },
+              { type: "TV", number: 1, connected: true },
+            ]);
+            return () => undefined;
+          },
+        }),
+      };
+    },
+    { apps, ps4, failLaunch },
+  );
+
+const tiles = (page) => page.locator("[data-itv-tile]");
+const focused = (page) => page.locator('[data-itv-tile][aria-current="true"]');
+const setHidden = (page, value) =>
+  page.evaluate((hidden) => {
+    Object.defineProperty(document, "hidden", { configurable: true, value: hidden });
+    document.dispatchEvent(new Event("visibilitychange"));
+  }, value);
+const holdOk = async (page) => {
+  await page.keyboard.down("Enter");
+  await page.waitForTimeout(800);
+  await page.keyboard.up("Enter");
+};
+
+test("first run shows the six apps, then the PS4, with Apps hidden and no labels", async ({ page }) => {
+  await installInventory(page);
+  await page.goto("/");
+  await expect(tiles(page)).toHaveCount(8);
+  // DOM order is fixed by key so moves only slide; read the visual order from the layout once tiles settle.
+  const visualOrder = () =>
+    tiles(page).evaluateAll((nodes) =>
+      nodes
+        .filter((node) => node.getAttribute("data-outside") !== "true")
+        .map((node) => ({ label: node.getAttribute("aria-label"), box: node.getBoundingClientRect() }))
+        .sort((a, b) => a.box.top - b.box.top || a.box.left - b.box.left)
+        .map((item) => item.label),
+    );
+  await expect.poll(visualOrder).toEqual(["Netflix", "Spotify", "YouTube", "Disney+", "HBO Max", "Prime Video", "PS4"]);
+  // Text appears only inside tile artwork.
+  await expect(page.locator("[data-itv-home]")).toHaveText(/^(PS4Apps|AppsPS4)$/);
+  await expect(focused(page)).toHaveAttribute("aria-label", "Netflix");
+  // Anchored at the bottom: the last row 60 px above the screen edge, rows growing upwards.
+  const box = (selector) => page.locator(selector).boundingBox();
+  await expect.poll(() => box('[data-itv-tile][aria-label="Netflix"]')).toMatchObject({ x: 105, y: 634, width: 250 });
+  await expect.poll(() => box('[data-itv-tile="ps4"]')).toMatchObject({ x: 105, y: 870 });
+  await expect(page.locator("#background-root canvas")).toHaveCount(0);
+});
+
+test("arrows stop at the edges; Back stays on the Home", async ({ page }) => {
+  await installInventory(page);
+  await page.goto("/");
+  await expect(focused(page)).toHaveAttribute("aria-label", "Netflix");
+  await page.keyboard.press("ArrowLeft");
+  await page.keyboard.press("ArrowUp");
+  await page.keyboard.press("Escape");
+  await expect(focused(page)).toHaveAttribute("aria-label", "Netflix");
+  await page.keyboard.press("ArrowRight");
+  await expect(focused(page)).toHaveAttribute("aria-label", "Spotify");
+  await page.keyboard.press("ArrowDown");
+  await expect(focused(page)).toHaveAttribute("aria-label", "PS4");
+  await expect(page.locator('[data-itv-tile="apps"]')).toHaveAttribute("data-outside", "true");
+  // Down from the last row reveals the hidden Apps tile; Up hides it again.
+  await page.keyboard.press("ArrowDown");
+  await expect(focused(page)).toHaveAttribute("aria-label", "Apps");
+  await expect(page.locator('[data-itv-tile="apps"]')).toHaveAttribute("data-outside", "false");
+  await page.keyboard.press("ArrowUp");
+  await expect(focused(page)).toHaveAttribute("aria-label", "PS4");
+  await expect(page.locator("[data-itv-home]")).toBeVisible();
+});
+
+test("holding OK opens Move and Hide; Hide removes the app", async ({ page }) => {
+  await installInventory(page);
+  await page.goto("/");
+  await expect(focused(page)).toHaveAttribute("aria-label", "Netflix");
+  await holdOk(page);
+  const menu = page.getByRole("menu", { name: "Netflix options" });
+  await expect(menu.getByRole("menuitem")).toHaveText(["Move", "Hide"]);
+  await page.keyboard.press("ArrowDown");
+  await page.keyboard.press("Enter");
+  await expect(menu).toHaveCount(0);
+  await expect(page.locator('[data-itv-tile][aria-label="Netflix"]')).toHaveCount(0);
+  await expect(page.locator("#toast")).toHaveText("Netflix hidden");
+  await page.reload();
+  await expect(tiles(page)).toHaveCount(7);
+  expect(await page.evaluate(() => window.itvLaunches)).toEqual([]);
+});
+
+test("OK opens the app and every return focuses the last-used app", async ({ page }) => {
+  await installInventory(page);
+  await page.goto("/");
+  await expect(focused(page)).toHaveAttribute("aria-label", "Netflix");
+  await page.waitForTimeout(500);
+  await page.keyboard.press("ArrowRight");
+  await page.keyboard.press("Enter");
+  await expect.poll(() => page.evaluate(() => window.itvLaunches)).toEqual(["rJeHak5zRg.Spotify"]);
+  await page.keyboard.press("ArrowDown");
+  await setHidden(page, true);
+  await setHidden(page, false);
+  await expect(focused(page)).toHaveAttribute("aria-label", "Spotify");
+  // Home pressed on the Home itself arrives as a main app control.
+  await page.keyboard.press("ArrowRight");
+  await page.evaluate(() => window.dispatchEvent(new Event("appcontrol")));
+  await expect(focused(page)).toHaveAttribute("aria-label", "Spotify");
+  await page.reload();
+  await expect(focused(page)).toHaveAttribute("aria-label", "Spotify");
+});
+
+test("a failed launch keeps the Home and says so", async ({ page }) => {
+  await installInventory(page, { failLaunch: true });
+  await page.goto("/");
+  await expect(focused(page)).toHaveAttribute("aria-label", "Netflix");
+  await page.waitForTimeout(500);
+  await page.keyboard.press("Enter");
+  await expect(page.locator("#toast")).toHaveText("Couldn’t open Netflix");
+  await expect(page.locator("[data-itv-home]")).toBeVisible();
+});
+
+test("the PS4 tile appears only while the console is connected", async ({ page }) => {
+  await installInventory(page, { ps4: false });
+  await page.goto("/");
+  await expect(tiles(page)).toHaveCount(7);
+  await expect(page.locator('[data-itv-tile="ps4"]')).toHaveCount(0);
+  await holdOk(page);
+  await page.keyboard.press("Escape");
+  await page.keyboard.press("ArrowDown");
+  await holdOk(page);
+  await expect(focused(page)).toHaveAttribute("aria-label", "Apps");
+  await expect(page.locator("#toast")).toHaveText("Apps has a fixed place");
+});
