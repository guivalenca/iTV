--- /dev/null
+++ b/launcher/src/itv/state/createItvHomeController.ts
@@ -0,0 +1,671 @@
+import type { AppsService } from "../../contracts/apps";
+import type { InputsService } from "../../contracts/inputs";
+import type { InputSource, InstalledApp } from "../../contracts/launcher";
+import type { InputAction, ScopedInputEvent } from "../../contracts/remoteInput";
+import { shortAppName } from "../../shared/apps/appNames";
+import { createStore } from "../../shared/state/createStore";
+import { COPY } from "../copy";
+import type { BrandLookup } from "../model/brands";
+import { BRAND_NAMES } from "../model/brands";
+import type { ItvLibrary } from "../model/library";
+import {
+  hideApp,
+  LIBRARY_STORAGE_KEY,
+  parseLibrary,
+  reconcileLibrary,
+  serializeLibrary,
+  setLastUsed,
+  setOrder,
+} from "../model/library";
+import type { Ps4Identity } from "../model/ps4";
+import { findPs4 } from "../model/ps4";
+import type { Direction, Tile } from "../model/tiles";
+import {
+  appKey,
+  APPS_KEY,
+  APPS_TILE,
+  buildTiles,
+  GRID_COLUMNS,
+  neighbour,
+  PS4_KEY,
+  rowCount,
+  swapApps,
+} from "../model/tiles";
+import type { ItvSound } from "../sounds/createItvSounds";
+
+// Rows shown at once. Further rows scroll into this window, so the wallpaper above stays free.
+export const VISIBLE_ROWS = 2;
+const MENU_CHOICES = ["move", "hide"] as const;
+export type MenuChoice = (typeof MENU_CHOICES)[number];
+
+export type BumpKind = Direction | "failed";
+// Opening an item: the tile grows while the screen goes dark, the item opens behind the dark screen,
+// and a return fades the Home back in. A launch that fails or never covers the Home reveals it again.
+export type Curtain = "clear" | "covering" | "covered" | "revealing";
+// The Home stays dark this long waiting for the opened item before giving the screen back.
+const COVERED_LIMIT_MS = 6000;
+// Holding Back this long on the Home switches the sound engine (temporary aid for the on-TV A/B test).
+const BACK_HOLD_MS = 1500;
+// The light sheen crosses the focused tile only on the first move after this long without navigating.
+const SHEEN_IDLE_MS = 150_000;
+// Arrows closer together than this switch focus without animation, so quick presses never queue up.
+const RAPID_INTERVAL_MS = 160;
+// Animation returns once the arrows have been quiet this long.
+const RAPID_SETTLE_MS = 260;
+
+export interface ItvHomeState {
+  readonly active: boolean;
+  readonly bump: Readonly<{ key: string; kind: BumpKind; serial: number }> | null;
+  readonly curtain: Curtain;
+  readonly entering: boolean;
+  readonly firstRow: number;
+  readonly focus: string;
+  readonly launching: string | null;
+  readonly menu: Readonly<{ key: string; selected: number }> | null;
+  readonly moving: string | null;
+  // Quick successive arrows: focus jumps without animating.
+  readonly rapid: boolean;
+  // The tile showing the occasional sheen, if any.
+  readonly sheen: string | null;
+  readonly tiles: readonly Tile[];
+}
+
+export interface ItvHomeDependencies {
+  apps: Pick<AppsService, "byId" | "getSnapshot" | "launch" | "openStore" | "subscribe">;
+  brands: BrandLookup;
+  // Motion durations in milliseconds; 0 when motion is off.
+  entranceMs: number;
+  inputs: Pick<InputsService, "getSnapshot" | "show" | "subscribe">;
+  longPressMs: number;
+  // Monotonic milliseconds (the wall clock can jump at cold boot).
+  now(): number;
+  onBackHold?(): void;
+  openMs: number;
+  ps4: Ps4Identity;
+  revealMs: number;
+  sounds: { markInput?(eventTime: number | undefined): void; play(sound: ItvSound): void; prepare(): void };
+  storage: Pick<Storage, "getItem" | "setItem">;
+  timers: Pick<Window, "clearTimeout" | "setTimeout">;
+  toast(message: string): void;
+}
+
+const ARROWS: Partial<Record<InputAction, Direction>> = { left: "left", right: "right", up: "up", down: "down" };
+
+const lastRowStart = (list: readonly Tile[]) => list[(rowCount(list.length) - 1) * GRID_COLUMNS]?.key || APPS_KEY;
+
+const firstVisibleRow = (tileCount: number, index: number, previous: number) => {
+  const lastStart = Math.max(0, rowCount(tileCount) - VISIBLE_ROWS);
+  const row = Math.floor(Math.max(0, index) / GRID_COLUMNS);
+  const keepVisible = Math.min(Math.max(previous, row - VISIBLE_ROWS + 1), row);
+  return Math.min(Math.max(0, keepVisible), lastStart);
+};
+
+export const createItvHomeController = (deps: ItvHomeDependencies) => {
+  const { apps, brands, inputs, sounds, timers } = deps;
+  let library: ItvLibrary = parseLibrary(readStored(deps.storage));
+  let draft: readonly string[] | null = null;
+  let pressTimer: number | undefined;
+  let rapidTimer: number | undefined;
+  let lastArrowAt: number | null = null;
+  let backTimer: number | undefined;
+  let entranceTimer: number | undefined;
+  let curtainTimer: number | undefined;
+  let pressing = false;
+  let queuedOk = false;
+  // Power-on focus waits for the last-used tile (for example the PS4) until the user navigates.
+  let awaitingLastUsed = true;
+  let launchToken = 0;
+  let bumpSerial = 0;
+  let navigationCount = 0;
+  let launchedByHome: string | null = null;
+  let disposed = false;
+  const store = createStore<ItvHomeState>({
+    active: true,
+    bump: null,
+    curtain: "clear",
+    entering: true,
+    firstRow: 0,
+    focus: "",
+    launching: null,
+    menu: null,
+    moving: null,
+    rapid: false,
+    sheen: null,
+    tiles: [],
+  });
+  const patch = (next: Partial<ItvHomeState>) => {
+    const before = store.getSnapshot();
+    if ((Object.keys(next) as (keyof ItvHomeState)[]).some((key) => before[key] !== next[key])) {
+      store.set({ ...before, ...next });
+    }
+  };
+  const saveLibrary = (next: ItvLibrary) => {
+    if (next === library) {
+      return;
+    }
+    library = next;
+    try {
+      deps.storage.setItem(LIBRARY_STORAGE_KEY, serializeLibrary(library));
+    } catch {
+      // The Home keeps working for this session when storage is full or unavailable.
+    }
+  };
+  const ps4Source = (): InputSource | null => findPs4(inputs.getSnapshot().sources, deps.ps4);
+  const visibleAppIds = () => {
+    const { all, ready } = apps.getSnapshot();
+    const installed = ready || all.length ? new Set(all.map((app) => app.id)) : null;
+    const hidden = new Set(library.hidden);
+    return (draft || library.order).filter((id) => !hidden.has(id) && (!installed || installed.has(id)));
+  };
+  // The grid tiles. The Apps tile waits hidden below them and is found with findTile.
+  const tiles = () => store.getSnapshot().tiles;
+  const indexOf = (key: string) => tiles().findIndex((tile) => tile.key === key);
+  const findTile = (key: string) => (key === APPS_KEY ? APPS_TILE : tiles().find((tile) => tile.key === key));
+  // The grid tile focused before Down revealed the Apps tile; Up goes back to it.
+  let revealedFrom: string | null = null;
+  const homeTarget = (list: readonly Tile[]) => {
+    const last = library.lastUsed;
+    return (last && list.find((tile) => tile.key === last)?.key) || list[0]?.key || APPS_KEY;
+  };
+  const place = (focus: string, list = tiles()) => {
+    // With the Apps tile revealed, the window shows the last grid rows and the Apps row beneath them.
+    const firstRow =
+      focus === APPS_KEY
+        ? Math.max(0, rowCount(list.length) - VISIBLE_ROWS)
+        : firstVisibleRow(
+            list.length,
+            list.findIndex((tile) => tile.key === focus),
+            store.getSnapshot().firstRow,
+          );
+    patch({ focus, firstRow });
+  };
+  // Rebuild tiles after an inventory or order change, keeping focus on the same tile or its old position.
+  const sync = () => {
+    if (disposed) {
+      return;
+    }
+    const { all, ready } = apps.getSnapshot();
+    if (ready) {
+      saveLibrary(
+        reconcileLibrary(
+          library,
+          all.map((app) => app.id),
+          (id) => brands.defaultRank(apps.byId(id) || { id }),
+        ),
+      );
+      if (draft) {
+        // Apps discovered during a move join the draft too, or placing the tile would drop them.
+        const current = draft;
+        const added = library.order.filter((id) => !current.includes(id));
+        draft = added.length ? [...current, ...added] : current;
+      }
+    }
+    const previous = store.getSnapshot();
+    const list = buildTiles(visibleAppIds(), ps4Source() !== null);
+    const sameTiles =
+      list.length === previous.tiles.length && list.every((tile, index) => tile.key === previous.tiles[index]?.key);
+    const nextTiles = sameTiles ? previous.tiles : list;
+    let focus = previous.focus;
+    if (awaitingLastUsed || !focus) {
+      focus = homeTarget(nextTiles);
+    } else if (focus === APPS_KEY && nextTiles.length) {
+      // The Apps tile stays focused while it is revealed.
+    } else if (focus === PS4_KEY && !nextTiles.some((tile) => tile.key === focus)) {
+      // A disconnected PS4 hands focus to the first tile, as on a return Home.
+      focus = nextTiles[0]?.key || APPS_KEY;
+    } else if (!nextTiles.some((tile) => tile.key === focus)) {
+      const oldIndex = previous.tiles.findIndex((tile) => tile.key === focus);
+      focus = nextTiles[Math.min(Math.max(oldIndex, 0), nextTiles.length - 1)]?.key || APPS_KEY;
+    }
+    if (library.lastUsed && nextTiles.some((tile) => tile.key === library.lastUsed)) {
+      awaitingLastUsed = false;
+    } else if (!library.lastUsed && apps.getSnapshot().ready) {
+      // Nothing was used yet: once discovery settles, the first tile is the right focus.
+      awaitingLastUsed = false;
+    }
+    const menu = previous.menu && nextTiles.some((tile) => tile.key === previous.menu?.key) ? previous.menu : null;
+    if (previous.moving && !nextTiles.some((tile) => tile.key === previous.moving)) {
+      draft = null;
+      patch({ moving: null });
+    }
+    patch({ tiles: nextTiles, menu });
+    place(focus, nextTiles);
+  };
+  const bump = (key: string, kind: BumpKind) => {
+    bumpSerial += 1;
+    patch({ bump: { key, kind, serial: bumpSerial } });
+    sounds.play("bump");
+  };
+  const cancelBackHold = () => {
+    if (backTimer !== undefined) {
+      timers.clearTimeout(backTimer);
+    }
+    backTimer = undefined;
+  };
+  const cancelPress = () => {
+    cancelBackHold();
+    if (pressTimer !== undefined) {
+      timers.clearTimeout(pressTimer);
+    }
+    pressTimer = undefined;
+    pressing = false;
+  };
+  const appName = (app: InstalledApp) => {
+    const brand = brands.brandOf(app);
+    return brand ? BRAND_NAMES[brand] : shortAppName(app.name);
+  };
+  const tileName = (tile: Tile) => {
+    if (tile.kind === "ps4") {
+      return COPY.ps4;
+    }
+    if (tile.kind === "apps") {
+      return COPY.apps;
+    }
+    const app = apps.byId(tile.appId || "");
+    return app ? appName(app) : tile.appId || "";
+  };
+  const clearCurtainTimer = () => {
+    if (curtainTimer !== undefined) {
+      timers.clearTimeout(curtainTimer);
+    }
+    curtainTimer = undefined;
+  };
+  // Fade the Home back in after an item opened, failed or never covered it.
+  const reveal = () => {
+    clearCurtainTimer();
+    if (store.getSnapshot().curtain === "clear") {
+      return;
+    }
+    patch({ curtain: "revealing", launching: null });
+    const finish = () => {
+      curtainTimer = undefined;
+      patch({ curtain: "clear" });
+    };
+    if (deps.revealMs > 0) {
+      curtainTimer = timers.setTimeout(finish, deps.revealMs);
+    } else {
+      finish();
+    }
+  };
+  const failed = (key: string, name: string, token: number, previousLastUsed: string | null) => () => {
+    if (disposed || token !== launchToken) {
+      return;
+    }
+    reveal();
+    if (library.lastUsed === key) {
+      saveLibrary(setLastUsed(library, previousLastUsed));
+    }
+    bump(key, "failed");
+    deps.toast(COPY.openFailed(name));
+  };
+  const open = (key: string) => {
+    const tile = findTile(key);
+    if (!tile || disposed) {
+      reveal();
+      return;
+    }
+    patch({ curtain: "covered" });
+    // If nothing covers the Home, the screen must not stay dark.
+    curtainTimer = timers.setTimeout(reveal, COVERED_LIMIT_MS);
+    launchToken += 1;
+    const token = launchToken;
+    const previousLastUsed = library.lastUsed;
+    const name = tileName(tile);
+    if (tile.kind === "apps") {
+      apps.openStore(failed(key, name, token, previousLastUsed));
+      return;
+    }
+    if (tile.kind === "ps4") {
+      const source = ps4Source();
+      if (!source) {
+        reveal();
+        return;
+      }
+      saveLibrary(setLastUsed(library, PS4_KEY));
+      inputs.show(source);
+      return;
+    }
+    const app = apps.byId(tile.appId || "");
+    if (!app) {
+      reveal();
+      return;
+    }
+    saveLibrary(setLastUsed(library, key));
+    launchedByHome = app.id;
+    apps.launch(app, failed(key, name, token, previousLastUsed));
+  };
+  const activate = (key: string) => {
+    if (!findTile(key)) {
+      return;
+    }
+    clearCurtainTimer();
+    patch({ curtain: "covering", launching: key });
+    if (deps.openMs > 0) {
+      curtainTimer = timers.setTimeout(() => {
+        curtainTimer = undefined;
+        open(key);
+      }, deps.openMs);
+    } else {
+      open(key);
+    }
+  };
+  const finishEntrance = () => {
+    entranceTimer = undefined;
+    patch({ entering: false });
+    if (queuedOk) {
+      queuedOk = false;
+      activate(store.getSnapshot().focus);
+    }
+  };
+  const openMenu = (key: string) => {
+    const tile = findTile(key);
+    if (!tile) {
+      return;
+    }
+    if (tile.kind !== "app") {
+      bump(key, "failed");
+      deps.toast(COPY.fixedPlace(tileName(tile)));
+      return;
+    }
+    sounds.play("grab");
+    patch({ menu: { key, selected: 0 } });
+  };
+  const endMove = (commit: boolean) => {
+    const moving = store.getSnapshot().moving;
+    if (!moving) {
+      return;
+    }
+    if (commit && draft) {
+      saveLibrary(setOrder(library, draft));
+    }
+    draft = null;
+    patch({ moving: null });
+    sync();
+    place(moving);
+  };
+  const choose = (choice: MenuChoice, key: string) => {
+    patch({ menu: null });
+    const id = tiles().find((tile) => tile.key === key)?.appId;
+    if (!id) {
+      return;
+    }
+    if (choice === "move") {
+      sounds.play("select");
+      draft = [...library.order];
+      patch({ moving: key });
+      return;
+    }
+    const app = apps.byId(id);
+    const index = indexOf(key);
+    sounds.play("back");
+    saveLibrary(hideApp(library, id));
+    sync();
+    const list = tiles();
+    place(list[Math.min(index, list.length - 1)]?.key || "");
+    deps.toast(COPY.hidden(app ? appName(app) : id));
+  };
+  // Pace focus moves: animate normally, but jump instantly while arrows come in quick succession, and show
+  // the sheen only on the first move after a long pause.
+  const paceArrow = () => {
+    const now = deps.now();
+    const sinceLast = lastArrowAt === null ? Infinity : now - lastArrowAt;
+    lastArrowAt = now;
+    if (rapidTimer !== undefined) {
+      timers.clearTimeout(rapidTimer);
+    }
+    rapidTimer = timers.setTimeout(() => {
+      rapidTimer = undefined;
+      patch({ rapid: false });
+    }, RAPID_SETTLE_MS);
+    patch({ rapid: sinceLast < RAPID_INTERVAL_MS });
+    return sinceLast >= SHEEN_IDLE_MS;
+  };
+  const moveFocus = (direction: Direction) => {
+    const showSheen = paceArrow();
+    const { focus, moving } = store.getSnapshot();
+    const list = tiles();
+    if (focus === APPS_KEY && !moving) {
+      // Up hides the Apps tile again and returns to the tile it was revealed from.
+      if (direction !== "up" || !list.length) {
+        bump(APPS_KEY, direction);
+        return;
+      }
+      const back = (revealedFrom && list.find((tile) => tile.key === revealedFrom)?.key) || lastRowStart(list);
+      sounds.play("move");
+      patch({ sheen: null });
+      place(back);
+      return;
+    }
+    const from = indexOf(moving || focus);
+    const to = from < 0 ? null : neighbour(list.length, from, direction);
+    const target = to === null ? undefined : list[to];
+    if (moving) {
+      const movingId = list[from]?.appId;
+      if (!target?.appId || !movingId || !draft) {
+        bump(moving, direction);
+        return;
+      }
+      draft = swapApps(draft, movingId, target.appId);
+      sounds.play("move");
+      sync();
+      place(moving);
+      return;
+    }
+    if (!target) {
+      // Down from the last row deliberately reveals the hidden Apps tile.
+      if (direction === "down" && from >= 0 && Math.floor(from / GRID_COLUMNS) === rowCount(list.length) - 1) {
+        revealedFrom = focus;
+        sounds.play("move");
+        patch({ sheen: showSheen ? APPS_KEY : null });
+        place(APPS_KEY);
+        return;
+      }
+      bump(focus, direction);
+      return;
+    }
+    sounds.play("move");
+    patch({ sheen: showSheen ? target.key : null });
+    place(target.key);
+  };
+  const handleMenu = (event: ScopedInputEvent, menu: NonNullable<ItvHomeState["menu"]>) => {
+    if (event.action === "up" || event.action === "down") {
+      const selected = menu.selected + (event.action === "down" ? 1 : -1);
+      if (selected < 0 || selected >= MENU_CHOICES.length) {
+        sounds.play("bump");
+        return;
+      }
+      sounds.play("move");
+      patch({ menu: { ...menu, selected } });
+    } else if (event.action === "confirm") {
+      choose(MENU_CHOICES[menu.selected], menu.key);
+    } else if (event.action === "back") {
+      sounds.play("back");
+      patch({ menu: null });
+    }
+  };
+  const keydown = (event: ScopedInputEvent, cancelScope: () => void) => {
+    const state = store.getSnapshot();
+    sounds.prepare();
+    if (state.curtain === "covering") {
+      return;
+    }
+    if (state.curtain === "covered") {
+      // Still waiting for the opened item: any key gives the Home back.
+      reveal();
+      return;
+    }
+    if (state.menu) {
+      handleMenu(event, state.menu);
+      return;
+    }
+    const direction = ARROWS[event.action];
+    if (direction) {
+      awaitingLastUsed = false;
+      navigationCount += 1;
+      queuedOk = false;
+      moveFocus(direction);
+      return;
+    }
+    if (event.action === "back") {
+      // The Home never exits: Back only cancels a move.
+      if (state.moving) {
+        sounds.play("back");
+        endMove(false);
+        return;
+      }
+      if (deps.onBackHold && backTimer === undefined && !event.repeat) {
+        const onBackHold = deps.onBackHold;
+        backTimer = timers.setTimeout(() => {
+          backTimer = undefined;
+          onBackHold();
+        }, BACK_HOLD_MS);
+      }
+      return;
+    }
+    if (event.action !== "confirm" || event.repeat) {
+      return;
+    }
+    if (state.moving) {
+      sounds.play("select");
+      endMove(true);
+      return;
+    }
+    if (pressing) {
+      return;
+    }
+    // The click sounds when OK goes down; waiting for its release would add the length of the press.
+    sounds.play("select");
+    pressing = true;
+    const key = state.focus;
+    pressTimer = timers.setTimeout(() => {
+      pressTimer = undefined;
+      pressing = false;
+      queuedOk = false;
+      // A hold must not also activate or choose from the menu it opened: drop this press.
+      cancelScope();
+      openMenu(key);
+    }, deps.longPressMs);
+  };
+  const keyup = (event: ScopedInputEvent) => {
+    if (event.action === "back") {
+      cancelBackHold();
+      return;
+    }
+    if (event.action !== "confirm" || pressTimer === undefined) {
+      return;
+    }
+    timers.clearTimeout(pressTimer);
+    pressTimer = undefined;
+    pressing = false;
+    awaitingLastUsed = false;
+    if (store.getSnapshot().entering) {
+      queuedOk = true;
+      return;
+    }
+    activate(store.getSnapshot().focus);
+  };
+  const reset = () => {
+    cancelPress();
+    queuedOk = false;
+    if (store.getSnapshot().moving) {
+      endMove(false);
+    }
+    patch({ menu: null });
+  };
+  sync();
+  if (deps.entranceMs > 0) {
+    entranceTimer = timers.setTimeout(finishEntrance, deps.entranceMs);
+  } else {
+    finishEntrance();
+  }
+  const unsubscribers = [apps.subscribe(sync), inputs.subscribe(sync)];
+  return {
+    getSnapshot: store.getSnapshot,
+    subscribe: store.subscribe,
+    handle(event: ScopedInputEvent, cancelScope: () => void) {
+      if (disposed || !store.getSnapshot().active) {
+        return;
+      }
+      sounds.markInput?.((event.nativeEvent as { timeStamp?: number }).timeStamp);
+      if (event.phase === "down") {
+        keydown(event, cancelScope);
+      } else {
+        keyup(event);
+      }
+    },
+    cancelPress,
+    // Every return to the Home, and Home pressed on the Home: focus the last-used item.
+    returnHome() {
+      if (disposed) {
+        return;
+      }
+      reset();
+      awaitingLastUsed = true;
+      navigationCount += 1;
+      patch({ active: true });
+      sync();
+      reveal();
+    },
+    // The Home is covered or hidden: drop pending input, the menu and an unfinished move.
+    // The focused tile keeps its look: a hidden page may show its last frame again on return.
+    leave() {
+      reset();
+      clearCurtainTimer();
+      patch({ active: false });
+    },
+    refresh: sync,
+    // The app the Home opened since it was last on screen, if any; reading it starts a new period.
+    takeLaunched() {
+      const id = launchedByHome;
+      launchedByHome = null;
+      return id;
+    },
+    // Navigation count when a return began, so late replies can tell whether the user has moved since.
+    navigationMark: () => navigationCount,
+    // A running-app observation says this app was opened outside the Home.
+    observeOpened(id: string, mark: number) {
+      const key = appKey(id);
+      if (disposed || !tiles().some((tile) => tile.key === key)) {
+        return;
+      }
+      saveLibrary(setLastUsed(library, key));
+      if (mark === navigationCount && !store.getSnapshot().menu && !store.getSnapshot().moving) {
+        place(key);
+      }
+    },
+    choose(index: number) {
+      const menu = store.getSnapshot().menu;
+      if (menu && MENU_CHOICES[index]) {
+        choose(MENU_CHOICES[index], menu.key);
+      }
+    },
+    gridIds: () =>
+      tiles()
+        .map((tile) => tile.appId)
+        .filter((id): id is string => !!id),
+    dispose() {
+      disposed = true;
+      cancelPress();
+      if (entranceTimer !== undefined) {
+        timers.clearTimeout(entranceTimer);
+      }
+      clearCurtainTimer();
+      if (rapidTimer !== undefined) {
+        timers.clearTimeout(rapidTimer);
+      }
+      unsubscribers.forEach((unsubscribe) => unsubscribe());
+    },
+  };
+};
+
+function readStored(storage: Pick<Storage, "getItem">) {
+  try {
+    return storage.getItem(LIBRARY_STORAGE_KEY);
+  } catch {
+    return null;
+  }
+}
+
+export type ItvHomeController = ReturnType<typeof createItvHomeController>;
+export const MENU_LABELS: Readonly<Record<MenuChoice, string>> = { move: COPY.move, hide: COPY.hide };
+export { MENU_CHOICES };
