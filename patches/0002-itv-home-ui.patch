@@ -0,0 +1,107 @@
+// The user's app library: tile order, hidden apps, apps already seen and the last-used item.
+// Pure functions only; the controller owns storage and timing.
+
+export const LIBRARY_STORAGE_KEY = "itv.home.v1";
+const MAX_STORED_IDS = 1000;
+
+export interface ItvLibrary {
+  readonly hidden: readonly string[];
+  readonly initialized: boolean;
+  // Every app installed when the Home first saw it, so later discoveries can tell new apps apart.
+  readonly known: readonly string[];
+  // Tile key of the last item opened by any route ("app:<id>" or the PS4 key). Settings and Apps never count.
+  readonly lastUsed: string | null;
+  // App order, including uninstalled apps so a reinstall returns to the same place.
+  readonly order: readonly string[];
+}
+
+export const EMPTY_LIBRARY: ItvLibrary = Object.freeze({
+  known: Object.freeze([]),
+  hidden: Object.freeze([]),
+  initialized: false,
+  lastUsed: null,
+  order: Object.freeze([]),
+});
+
+const readIds = (value: unknown): readonly string[] =>
+  Array.isArray(value)
+    ? Object.freeze(
+        [...new Set((value as unknown[]).filter((id): id is string => typeof id === "string" && id.length > 0))].slice(
+          0,
+          MAX_STORED_IDS,
+        ),
+      )
+    : EMPTY_LIBRARY.order;
+
+export const parseLibrary = (text: string | null): ItvLibrary => {
+  if (!text) {
+    return EMPTY_LIBRARY;
+  }
+  try {
+    const value: unknown = JSON.parse(text);
+    if (!value || typeof value !== "object") {
+      return EMPTY_LIBRARY;
+    }
+    const record = value as Record<string, unknown>;
+    return Object.freeze({
+      known: readIds(record.known),
+      hidden: readIds(record.hidden),
+      initialized: record.initialized === true,
+      lastUsed: typeof record.lastUsed === "string" && record.lastUsed ? record.lastUsed : null,
+      order: readIds(record.order),
+    });
+  } catch {
+    return EMPTY_LIBRARY;
+  }
+};
+
+export const serializeLibrary = (library: ItvLibrary) => JSON.stringify(library);
+
+const sameIds = (left: readonly string[], right: readonly string[]) =>
+  left.length === right.length && left.every((id, index) => id === right[index]);
+
+// First run: the six chosen apps that are installed, in their spec order. Everything else present then
+// counts as pre-installed and stays hidden. Later runs: apps never seen before join the end of the order.
+export const reconcileLibrary = (
+  library: ItvLibrary,
+  installedIds: readonly string[],
+  defaultRank: (id: string) => number,
+): ItvLibrary => {
+  if (!library.initialized) {
+    const order = installedIds
+      .filter((id) => defaultRank(id) >= 0)
+      .sort((left, right) => defaultRank(left) - defaultRank(right));
+    return Object.freeze({
+      ...library,
+      initialized: true,
+      known: Object.freeze([...new Set([...library.known, ...installedIds])]),
+      order: Object.freeze([...new Set([...library.order, ...order])]),
+    });
+  }
+  const known = new Set(library.known);
+  const fresh = installedIds.filter((id) => !known.has(id));
+  if (!fresh.length) {
+    return library;
+  }
+  const placed = new Set([...library.order, ...library.hidden]);
+  const order = [...library.order, ...fresh.filter((id) => !placed.has(id))];
+  return Object.freeze({
+    ...library,
+    known: Object.freeze([...library.known, ...fresh]),
+    order: sameIds(order, library.order) ? library.order : Object.freeze(order),
+  });
+};
+
+export const hideApp = (library: ItvLibrary, id: string): ItvLibrary =>
+  Object.freeze({
+    ...library,
+    hidden: library.hidden.includes(id) ? library.hidden : Object.freeze([...library.hidden, id]),
+    order: Object.freeze(library.order.filter((item) => item !== id)),
+    lastUsed: library.lastUsed === "app:" + id ? null : library.lastUsed,
+  });
+
+export const setOrder = (library: ItvLibrary, order: readonly string[]): ItvLibrary =>
+  sameIds(order, library.order) ? library : Object.freeze({ ...library, order: Object.freeze([...order]) });
+
+export const setLastUsed = (library: ItvLibrary, key: string | null): ItvLibrary =>
+  library.lastUsed === key ? library : Object.freeze({ ...library, lastUsed: key });
