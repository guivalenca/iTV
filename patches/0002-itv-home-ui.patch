index 0000000..00233bc
--- /dev/null
+++ b/launcher/src/itv/components/Tile/Tile.tsx
@@ -0,0 +1,100 @@
+import { memo } from "preact/compat";
+import { useLayoutEffect, useRef } from "preact/hooks";
+
+import type { InstalledApp } from "../../../contracts/launcher";
+import { ENTRANCE_COHORT } from "../../layout";
+import type { Brand } from "../../model/brands";
+import type { Tile as TileModel } from "../../model/tiles";
+import type { BumpKind } from "../../state/createItvHomeController";
+import { TileArtwork } from "../TileArtwork/TileArtwork";
+
+import styles from "./Tile.module.css";
+
+const BUMP_DISTANCE_PX = 14;
+const BUMP_KEYFRAMES: Readonly<Record<BumpKind, Keyframe[]>> = {
+  left: [
+    { transform: "none" },
+    { transform: `translateX(-${BUMP_DISTANCE_PX}px)`, offset: 0.4 },
+    { transform: "none" },
+  ],
+  right: [
+    { transform: "none" },
+    { transform: `translateX(${BUMP_DISTANCE_PX}px)`, offset: 0.4 },
+    { transform: "none" },
+  ],
+  up: [{ transform: "none" }, { transform: `translateY(-${BUMP_DISTANCE_PX}px)`, offset: 0.4 }, { transform: "none" }],
+  down: [{ transform: "none" }, { transform: `translateY(${BUMP_DISTANCE_PX}px)`, offset: 0.4 }, { transform: "none" }],
+  // A short head shake when an app cannot open or a tile cannot be changed.
+  failed: [
+    { transform: "none" },
+    { transform: "translateX(-10px)", offset: 0.25 },
+    { transform: "translateX(8px)", offset: 0.55 },
+    { transform: "translateX(-4px)", offset: 0.8 },
+    { transform: "none" },
+  ],
+};
+const BUMP_EASING = "ease";
+
+export interface TileProps {
+  readonly app: InstalledApp | null;
+  readonly brand: Brand | null;
+  readonly bump: Readonly<{ kind: BumpKind; serial: number }> | null;
+  // Bump duration from the motion tokens; 0 turns the nudge off.
+  readonly bumpMs: number;
+  readonly focused: boolean;
+  readonly index: number;
+  readonly label: string;
+  // The item is opening: the tile grows while the screen darkens.
+  readonly launching: boolean;
+  readonly moving: boolean;
+  readonly outside: boolean;
+  // The occasional light sheen crosses this tile as it takes focus.
+  readonly sheen: boolean;
+  readonly tile: TileModel;
+  readonly x: number;
+  readonly y: number;
+}
+
+// Slot (fixed 250×150 place) → rise (entrance) → nudge (bump, wiggle) → lift (focus scale) → face.
+// Memoised: a focus move re-renders only the two tiles whose props change.
+export const Tile = memo(
+  ({ app, brand, bump, bumpMs, focused, index, label, launching, moving, outside, sheen, tile, x, y }: TileProps) => {
+    const nudge = useRef<HTMLDivElement>(null);
+    useLayoutEffect(() => {
+      const node = nudge.current;
+      if (!bump || !node || bumpMs <= 0 || typeof node.animate !== "function") {
+        return;
+      }
+      const animation = node.animate(BUMP_KEYFRAMES[bump.kind], { duration: bumpMs, easing: BUMP_EASING });
+      return () => animation.cancel();
+    }, [bump, bumpMs]);
+    return (
+      <div
+        class={styles.slot}
+        role="button"
+        aria-label={label}
+        aria-current={focused ? "true" : undefined}
+        data-itv-tile={tile.key}
+        data-kind={tile.kind}
+        data-focused={focused ? "true" : "false"}
+        data-launching={launching ? "true" : "false"}
+        data-moving={moving ? "true" : "false"}
+        data-outside={outside ? "true" : "false"}
+        data-sheen={sheen ? "true" : "false"}
+        style={{ transform: `translate(${x}px, ${y}px)`, "--itv-index": String(Math.min(index, ENTRANCE_COHORT - 1)) }}
+      >
+        <div class={styles.rise}>
+          <div class={styles.nudge} ref={nudge}>
+            <div class={styles.lift}>
+              <div class={styles.shadow} />
+              <div class={styles.face}>
+                <TileArtwork app={app} brand={brand} kind={tile.kind} />
+                <div class={styles.sheen} />
+              </div>
+            </div>
+          </div>
+        </div>
+      </div>
+    );
+  },
+);
