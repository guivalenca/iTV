+import { expect, test, vi } from "vitest";
+
+import { createRunningApps } from "./createRunningApps";
+
+const tizenWith = (...snapshots: string[][]) => {
+  const replies = [...snapshots];
+  return {
+    application: {
+      getAppsContext: (done: (contexts: { appId: string }[]) => void) =>
+        done((replies.shift() || []).map((appId) => ({ appId }))),
+    },
+  };
+};
+const grid = () => ["netflix", "youtube", "spotify"];
+
+test("reports the only Home app that started while the Home was away", () => {
+  const running = createRunningApps(tizenWith(["self"], ["self", "youtube"]));
+  const opened = vi.fn();
+  running.observeReturn(grid, null, opened);
+  running.observeReturn(grid, null, opened);
+  expect(opened).toHaveBeenCalledWith("youtube");
+});
+
+test("ignores the app the Home opened itself, but not one opened from inside it", () => {
+  const running = createRunningApps(tizenWith([], ["netflix", "spotify"]));
+  const opened = vi.fn();
+  running.observeReturn(grid, null, opened);
+  running.observeReturn(grid, "netflix", opened);
+  expect(opened).toHaveBeenCalledWith("spotify");
+});
+
+test("keeps the confirmed item when the evidence is ambiguous or missing", () => {
+  const ambiguous = createRunningApps(tizenWith([], ["netflix", "youtube"]));
+  const opened = vi.fn();
+  ambiguous.observeReturn(grid, null, opened);
+  ambiguous.observeReturn(grid, null, opened);
+  const resumed = createRunningApps(tizenWith(["youtube"], ["youtube"]));
+  resumed.observeReturn(grid, null, opened);
+  resumed.observeReturn(grid, null, opened);
+  createRunningApps(null).observeReturn(grid, null, opened);
+  expect(opened).not.toHaveBeenCalled();
+});
+
+test("a cancelled observation never reports", () => {
+  let reply: ((contexts: { appId: string }[]) => void) | undefined;
+  const running = createRunningApps({
+    application: {
+      getAppsContext: (done) => {
+        reply = done;
+      },
+    },
+  });
+  const opened = vi.fn();
+  running.observeReturn(grid, null, opened);
+  reply?.([]);
+  running.observeReturn(grid, null, opened);
+  running.cancel();
+  reply?.([{ appId: "youtube" }]);
+  expect(opened).not.toHaveBeenCalled();
+});
diff --git a/launcher/src/itv/platform/createRunningApps.ts b/launcher/src/itv/platform/createRunningApps.ts
new file mode 100644
index 0000000..a4a4522
--- /dev/null
+++ b/launcher/src/itv/platform/createRunningApps.ts
@@ -0,0 +1,72 @@
+// Best-effort record of apps opened outside the Home, for example by the remote's app buttons.
+// In Native Home mode the Watcher service is idle, so the launcher compares the running apps it saw
+// when it was last on screen with those running when it returns. Only one newly running Home app is
+// taken as evidence; anything ambiguous keeps the confirmed last-used item.
+
+interface AppContext {
+  readonly appId?: unknown;
+}
+
+export interface RunningAppsTizen {
+  application?: {
+    getAppsContext?(done: (contexts: readonly AppContext[]) => void, failed?: () => void): void;
+  };
+}
+
+const readIds = (contexts: unknown): ReadonlySet<string> | null =>
+  Array.isArray(contexts)
+    ? new Set(
+        (contexts as (AppContext | null)[])
+          .map((context) => context?.appId)
+          .filter((id): id is string => typeof id === "string" && id.length > 0),
+      )
+    : null;
+
+export const createRunningApps = (tizen: RunningAppsTizen | null | undefined) => {
+  let seen: ReadonlySet<string> | null = null;
+  let generation = 0;
+  const read = (done: (ids: ReadonlySet<string> | null) => void) => {
+    const request = ++generation;
+    const finish = (ids: ReadonlySet<string> | null) => {
+      if (request === generation) {
+        done(ids);
+      }
+    };
+    try {
+      if (!tizen?.application?.getAppsContext) {
+        finish(null);
+        return;
+      }
+      tizen.application.getAppsContext(
+        (contexts) => finish(readIds(contexts)),
+        () => finish(null),
+      );
+    } catch {
+      finish(null);
+    }
+  };
+  return {
+    // Call when the Home comes back on screen. Reports the only Home app that started while it was away,
+    // apart from the one the Home itself opened (anything newer than that was opened from inside it).
+    observeReturn(homeAppIds: () => readonly string[], launchedByHome: string | null, opened: (id: string) => void) {
+      const before = seen;
+      read((now) => {
+        if (!now) {
+          return;
+        }
+        seen = now;
+        if (!before) {
+          return;
+        }
+        const started = homeAppIds().filter((id) => id !== launchedByHome && now.has(id) && !before.has(id));
+        if (started.length === 1) {
+          opened(started[0]);
+        }
+      });
+    },
+    // A newer request or teardown makes pending replies stale.
+    cancel() {
+      generation += 1;
+    },
+  };
+};
diff --git a/launcher/src/itv/sounds/createItvSounds.ts b/launcher/src/itv/sounds/createItvSounds.ts
new file mode 100644
index 0000000..84d2f69
--- /dev/null
+++ b/launcher/src/itv/sounds/createItvSounds.ts
@@ -0,0 +1,288 @@
+// Remote UI sounds: short, soft taps in the manner of TV interfaces, synthesised in code (no audio files).
+// Each sound is rendered once into an AudioBuffer, so a key press only starts a ready buffer: no node graph
+// is built and nothing is scheduled ahead of the audio clock.
+
+export type ItvSound = "move" | "bump" | "select" | "back" | "grab";
+
+type AudioHost = {
+  AudioContext?: typeof AudioContext;
+  OfflineAudioContext?: typeof OfflineAudioContext;
+  webkitAudioContext?: typeof AudioContext;
+};
+
+const MASTER_GAIN = 0.6;
+const SILENCE = 0.0001;
+const RENDER_SECONDS = 0.12;
+const NOISE_SECONDS = 0.05;
+// Chromium pauses an audio output after about 30 s of exact silence, and the next sound waits for it to
+// restart. A looped, inaudible noise (about -80 dBFS) keeps the output running while the Home is visible.
+const KEEP_ALIVE_LEVEL = 0.0001;
+const KEEP_ALIVE_SECONDS = 1;
+// The last key-to-sound measurements, read on the TV with `aerotizen inspect launcher`.
+const MEASUREMENTS_KEPT = 40;
+const MAX_KEY_AGE_MS = 1000;
+
+interface ToneOptions {
+  readonly attack?: number;
+  readonly decay: number;
+  readonly peak: number;
+  readonly to?: number;
+}
+
+interface NoiseOptions {
+  readonly decay: number;
+  readonly freq: number;
+  readonly peak: number;
+  readonly q?: number;
+  readonly type?: BiquadFilterType;
+}
+
+interface Voice {
+  noise(options: NoiseOptions): void;
+  tone(frequency: number, options: ToneOptions): void;
+}
+
+const createVoice = (context: BaseAudioContext): Voice => {
+  const noiseBuffer = context.createBuffer(1, Math.floor(context.sampleRate * NOISE_SECONDS), context.sampleRate);
+  const samples = noiseBuffer.getChannelData(0);
+  for (let i = 0; i < samples.length; i++) {
+    samples[i] = Math.random() * 2 - 1;
+  }
+  const envelope = (gain: GainNode, peak: number, attack: number, decay: number) => {
+    gain.gain.setValueAtTime(SILENCE, 0);
+    gain.gain.exponentialRampToValueAtTime(peak, attack);
+    gain.gain.exponentialRampToValueAtTime(SILENCE, attack + decay);
+  };
+  return {
+    tone(frequency, { attack = 0.001, decay, peak, to }) {
+      const oscillator = context.createOscillator();
+      const gain = context.createGain();
+      oscillator.frequency.setValueAtTime(frequency, 0);
+      if (to) {
+        oscillator.frequency.exponentialRampToValueAtTime(to, attack + decay);
+      }
+      envelope(gain, peak, attack, decay);
+      oscillator.connect(gain);
+      gain.connect(context.destination);
+      oscillator.start(0);
+      oscillator.stop(attack + decay + 0.01);
+    },
+    noise({ decay, freq, peak, q = 1, type = "bandpass" }) {
+      const source = context.createBufferSource();
+      const filter = context.createBiquadFilter();
+      const gain = context.createGain();
+      source.buffer = noiseBuffer;
+      filter.type = type;
+      filter.frequency.value = freq;
+      filter.Q.value = q;
+      envelope(gain, peak, 0.0005, decay);
+      source.connect(filter);
+      filter.connect(gain);
+      gain.connect(context.destination);
+      source.start(0);
+      source.stop(decay + 0.01);
+    },
+  };
+};
+
+// "Felt" set, chosen by the user in the sound lab on 2026-11-17: soft, low taps with almost no click.
+const SOUNDS: Readonly<Record<ItvSound, (voice: Voice) => void>> = {
+  // A barely-there tap for every focus move.
+  move(voice) {
+    voice.tone(720, { peak: 0.08, attack: 0.001, decay: 0.02, to: 640 });
+    voice.noise({ peak: 0.06, decay: 0.004, freq: 1800, q: 0.7 });
+  },
+  // A soft, low thud when focus cannot move further.
+  bump(voice) {
+    voice.tone(170, { peak: 0.26, attack: 0.002, decay: 0.055, to: 115 });
+    voice.noise({ peak: 0.07, decay: 0.008, freq: 500, q: 0.7, type: "lowpass" });
+  },
+  // A soft thock for OK.
+  select(voice) {
+    voice.tone(420, { peak: 0.2, attack: 0.001, decay: 0.055, to: 320 });
+    voice.noise({ peak: 0.07, decay: 0.006, freq: 1500, q: 0.7 });
+  },
+  // The same thock, lower, for Back.
+  back(voice) {
+    voice.tone(330, { peak: 0.18, attack: 0.001, decay: 0.055, to: 260 });
+    voice.noise({ peak: 0.05, decay: 0.006, freq: 1200, q: 0.7 });
+  },
+  // A thock that lifts slightly when the hold menu opens.
+  grab(voice) {
+    voice.tone(380, { peak: 0.16, attack: 0.002, decay: 0.07, to: 520 });
+    voice.noise({ peak: 0.06, decay: 0.006, freq: 1500, q: 0.7 });
+  },
+};
+
+const SOUND_NAMES = Object.keys(SOUNDS) as ItvSound[];
+
+export interface AudioMeasurement {
+  readonly baseLatencyMs: number | null;
+  // How long until the engine expects the first sample to leave, from getOutputTimestamp().
+  readonly etaMs: number | null;
+  readonly idleMs: number | null;
+  // Time from the key event to this sound starting in the page, when the event time is known.
+  readonly keyAgeMs: number | null;
+  readonly outputLatencyMs: number | null;
+  readonly sound: ItvSound;
+  readonly state: string;
+}
+
+type TimedContext = AudioContext & {
+  baseLatency?: number;
+  getOutputTimestamp?(): { contextTime?: number; performanceTime?: number };
+  outputLatency?: number;
+};
+
+const toMs = (seconds: number | undefined) =>
+  typeof seconds === "number" && Number.isFinite(seconds) ? Math.round(seconds * 1000) : null;
+
+const engineEta = (context: TimedContext) => {
+  try {
+    const stamp = context.getOutputTimestamp?.();
+    if (!stamp || typeof stamp.contextTime !== "number" || typeof stamp.performanceTime !== "number") {
+      return null;
+    }
+    const lagMs = (context.currentTime - stamp.contextTime) * 1000;
+    return Math.round(lagMs - (performance.now() - stamp.performanceTime));
+  } catch {
+    return null;
+  }
+};
+
+// One context for the page. Create it when the Home mounts and resume it on every return, so a key press
+// never waits for the audio device to wake.
+export const createItvSounds = (host: AudioHost) => {
+  let context: AudioContext | null = null;
+  let master: GainNode | null = null;
+  let keepAlive: AudioBufferSourceNode | null = null;
+  let failed = false;
+  let lastPlayedAt: number | null = null;
+  let inputTime: number | null = null;
+  const measurements: AudioMeasurement[] = [];
+  const startKeepAlive = (current: AudioContext) => {
+    const length = Math.floor(current.sampleRate * KEEP_ALIVE_SECONDS);
+    const buffer = current.createBuffer(1, length, current.sampleRate);
+    const samples = buffer.getChannelData(0);
+    for (let i = 0; i < length; i++) {
+      samples[i] = (Math.random() * 2 - 1) * KEEP_ALIVE_LEVEL;
+    }
+    keepAlive = current.createBufferSource();
+    keepAlive.buffer = buffer;
+    keepAlive.loop = true;
+    keepAlive.connect(current.destination);
+    keepAlive.start();
+  };
+  const buffers = new Map<ItvSound, AudioBuffer>();
+  const render = (sound: ItvSound, sampleRate: number) => {
+    const Offline = host.OfflineAudioContext;
+    if (!Offline) {
+      return;
+    }
+    try {
+      const offline = new Offline(1, Math.ceil(sampleRate * RENDER_SECONDS), sampleRate);
+      SOUNDS[sound](createVoice(offline));
+      void offline.startRendering().then(
+        (buffer) => {
+          buffers.set(sound, buffer);
+        },
+        () => undefined,
+      );
+    } catch {
+      // A sound that cannot be rendered stays silent.
+    }
+  };
+  const ensure = () => {
+    if (failed) {
+      return null;
+    }
+    try {
+      if (!context) {
+        const Context = host.AudioContext || host.webkitAudioContext;
+        if (!Context) {
+          failed = true;
+          return null;
+        }
+        context = new Context({ latencyHint: "interactive" });
+        master = context.createGain();
+        master.gain.value = MASTER_GAIN;
+        master.connect(context.destination);
+        const sampleRate = context.sampleRate;
+        SOUND_NAMES.forEach((sound) => render(sound, sampleRate));
+        startKeepAlive(context);
+      }
+      if (context.state === "suspended") {
+        void context.resume().catch(() => undefined);
+      }
+      return context;
+    } catch {
+      failed = true;
+      return null;
+    }
+  };
+  return {
+    // Create or wake the audio output ahead of the next key press.
+    prepare() {
+      ensure();
+    },
+    // The time stamp of the key event being handled, for the next measurement.
+    markInput(eventTime: number | undefined) {
+      inputTime = typeof eventTime === "number" ? eventTime : null;
+    },
+    play(sound: ItvSound) {
+      const ready = ensure();
+      const buffer = buffers.get(sound);
+      if (!ready || !master || !buffer) {
+        return;
+      }
+      try {
+        const source = ready.createBufferSource();
+        source.buffer = buffer;
+        source.connect(master);
+        source.start();
+      } catch {
+        // A sound must never interrupt navigation.
+      }
+      const now = performance.now();
+      const keyAge = inputTime === null ? null : Math.round(now - inputTime);
+      const timed = ready as TimedContext;
+      measurements.push({
+        sound,
+        state: ready.state,
+        keyAgeMs: keyAge !== null && keyAge >= 0 && keyAge <= MAX_KEY_AGE_MS ? keyAge : null,
+        idleMs: lastPlayedAt === null ? null : Math.round(now - lastPlayedAt),
+        etaMs: engineEta(timed),
+        baseLatencyMs: toMs(timed.baseLatency),
+        outputLatencyMs: toMs(timed.outputLatency),
+      });
+      if (measurements.length > MEASUREMENTS_KEPT) {
+        measurements.shift();
+      }
+      lastPlayedAt = now;
+      inputTime = null;
+    },
+    // Release the audio output while the Home is hidden, so it is not held under other apps.
+    pause() {
+      if (context && context.state === "running") {
+        void context.suspend().catch(() => undefined);
+      }
+    },
+    report: (): readonly AudioMeasurement[] => [...measurements],
+    dispose() {
+      const current = context;
+      context = null;
+      master = null;
+      keepAlive = null;
+      buffers.clear();
+      if (current) {
+        try {
+          void current.close().catch(() => undefined);
+        } catch {
+          // Older TV audio implementations can throw during teardown.
+        }
+      }
+    },
+  };
+};
+
+export type ItvSounds = ReturnType<typeof createItvSounds>;
