+import { useMemo } from "preact/hooks";
+
+import type { WallpaperName } from "../../config";
+import { WALLPAPERS } from "../../config";
+
+import { createGrainTile } from "./createGrainTile";
+import styles from "./Wallpaper.module.css";
+
+// A static gradient with grain and a soft bottom shade. Nothing here animates.
+export const Wallpaper = ({ name, document }: { document: Document; name: WallpaperName }) => {
+  const grain = useMemo(() => createGrainTile(document), [document]);
+  return (
+    <div class={styles.wallpaper} style={{ backgroundImage: WALLPAPERS[name] }} aria-hidden="true" data-itv-wallpaper>
+      {grain && <div class={styles.grain} style={{ backgroundImage: "url(" + grain + ")" }} />}
+      <div class={styles.shade} />
+    </div>
+  );
+};
