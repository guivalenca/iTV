@@ -0,0 +1,426 @@
+import { afterEach, beforeEach, describe, expect, test, vi } from "vitest";
+
+import type { AppsSnapshot } from "../../contracts/apps";
+import type { InputsSnapshot } from "../../contracts/inputs";
+import type { InputSource, InstalledApp } from "../../contracts/launcher";
+import { launcherConfig } from "../../launcherConfig";
+import { appCatalog } from "../../shared/apps/appCatalog";
+import { createInputDispatcher } from "../../shared/input/createInputDispatcher";
+import { createInputScope } from "../../shared/input/createInputScope";
+import { createStore } from "../../shared/state/createStore";
+import { createBrandLookup } from "../model/brands";
+import { LIBRARY_STORAGE_KEY, parseLibrary } from "../model/library";
+
+import { createItvHomeController } from "./createItvHomeController";
+
+const { KEY } = launcherConfig;
+const LONG_PRESS_MS = 600;
+const ENTRANCE_MS = 400;
+const OPEN_MS = 220;
+const BACK_HOLD_MS = 1500;
+const COVERED_LIMIT_MS = 6000;
+const SIX: readonly InstalledApp[] = [
+  { id: "org.tizen.primevideo", name: "Prime Video", icon: "" },
+  { id: "org.tizen.netflix-app", name: "Netflix", icon: "" },
+  { id: "rJeHak5zRg.Spotify", name: "Spotify", icon: "" },
+  { id: "9Ur5IzDKqV.TizenYouTube", name: "YouTube", icon: "" },
+  { id: "MCmYXNxgcu.DisneyPlus", name: "Disney+", icon: "" },
+  { id: "fjpfQryJuR.HBOMaxCTV", name: "HBO Max", icon: "" },
+  { id: "tvplus", name: "Samsung TV Plus", icon: "" },
+];
+const NETFLIX = "app:org.tizen.netflix-app";
+const SPOTIFY = "app:rJeHak5zRg.Spotify";
+const PS4: InputSource = { type: "HDMI", number: 1, editName: "PS4", connected: true };
+
+const harness = ({
+  entranceMs = 0,
+  onBackHold,
+  openMs = 0,
+  stored,
+}: { entranceMs?: number; onBackHold?: () => void; openMs?: number; stored?: string } = {}) => {
+  const storage = new Map<string, string>(stored ? [[LIBRARY_STORAGE_KEY, stored]] : []);
+  const apps = createStore<AppsSnapshot>({ all: [], inventory: [], realIds: [], ready: false });
+  const inputs = createStore<InputsSnapshot>({ playback: "idle", sources: [], visibleSources: [] });
+  const launches: { app: InstalledApp; fail?: () => void }[] = [];
+  const appsService = {
+    getSnapshot: apps.getSnapshot,
+    subscribe: apps.subscribe,
+    byId: (id: string) => apps.getSnapshot().all.find((app) => app.id === id) || null,
+    launch: vi.fn((app: InstalledApp, fail?: () => void) => launches.push({ app, fail })),
+    openStore: vi.fn(),
+  };
+  const show = vi.fn();
+  const sounds = { play: vi.fn(), prepare: vi.fn() };
+  const toast = vi.fn();
+  const controller = createItvHomeController({
+    apps: appsService,
+    brands: createBrandLookup(appCatalog),
+    entranceMs,
+    inputs: { getSnapshot: inputs.getSnapshot, subscribe: inputs.subscribe, show },
+    longPressMs: LONG_PRESS_MS,
+    now: () => Date.now(),
+    onBackHold,
+    openMs,
+    revealMs: 0,
+    ps4: { fixedPort: null },
+    sounds,
+    storage: { getItem: (key) => storage.get(key) ?? null, setItem: (key, value) => void storage.set(key, value) },
+    timers: window,
+    toast,
+  });
+  const scope = createInputScope({
+    onCancel: controller.cancelPress,
+    handle(event) {
+      controller.handle(event, () => scope.cancel());
+      return "handled";
+    },
+  });
+  const dispatcher = createInputDispatcher(KEY, [scope]);
+  const native = () => ({ preventDefault: vi.fn() });
+  const press = (code: number) => {
+    dispatcher.keydown(code, native());
+    dispatcher.keyup(code, native());
+  };
+  const down = (code: number) => dispatcher.keydown(code, native());
+  const hold = (code: number) => {
+    dispatcher.keydown(code, native());
+    vi.advanceTimersByTime(LONG_PRESS_MS + 50);
+    dispatcher.keydown(code, { ...native(), repeat: true });
+    dispatcher.keyup(code, native());
+  };
+  const discover = (all: readonly InstalledApp[], sources: readonly InputSource[] = [PS4]) => {
+    inputs.set({ ...inputs.getSnapshot(), sources });
+    apps.set({ ...apps.getSnapshot(), all, ready: true });
+  };
+  const keys = () => controller.getSnapshot().tiles.map((tile) => tile.key);
+  return {
+    apps,
+    appsService,
+    controller,
+    discover,
+    down,
+    hold,
+    inputs,
+    keys,
+    launches,
+    press,
+    show,
+    sounds,
+    storage,
+    toast,
+  };
+};
+
+beforeEach(() => {
+  vi.useFakeTimers();
+});
+afterEach(() => {
+  vi.useRealTimers();
+});
+
+describe("iTV Home controller", () => {
+  test("first discovery lays out the six apps, then the PS4", () => {
+    const h = harness();
+    expect(h.keys()).toEqual([]);
+    expect(h.controller.getSnapshot().focus).toBe("apps");
+    h.discover(SIX);
+    expect(h.keys()).toEqual([
+      NETFLIX,
+      SPOTIFY,
+      "app:9Ur5IzDKqV.TizenYouTube",
+      "app:MCmYXNxgcu.DisneyPlus",
+      "app:fjpfQryJuR.HBOMaxCTV",
+      "app:org.tizen.primevideo",
+      "ps4",
+    ]);
+    expect(h.controller.getSnapshot().focus).toBe(NETFLIX);
+  });
+
+  test("cached labels before discovery do not set the pre-installed baseline", () => {
+    const h = harness();
+    h.apps.set({ ...h.apps.getSnapshot(), all: SIX, ready: false });
+    expect(h.storage.has(LIBRARY_STORAGE_KEY)).toBe(false);
+    h.discover([...SIX, { id: "new", name: "Globoplay", icon: "" }]);
+    expect(h.keys()).not.toContain("app:new");
+    h.discover([...SIX, { id: "new", name: "Globoplay", icon: "" }, { id: "later", name: "Twitch", icon: "" }]);
+    expect(h.keys().indexOf("app:later")).toBe(6);
+  });
+
+  test("arrows stop at the edges with a bump", () => {
+    const h = harness();
+    h.discover(SIX);
+    h.press(KEY.LEFT);
+    expect(h.controller.getSnapshot()).toMatchObject({ focus: NETFLIX, bump: { key: NETFLIX, kind: "left" } });
+    expect(h.sounds.play).toHaveBeenLastCalledWith("bump");
+    h.press(KEY.RIGHT);
+    expect(h.controller.getSnapshot().focus).toBe(SPOTIFY);
+    expect(h.sounds.play).toHaveBeenLastCalledWith("move");
+    h.press(KEY.DOWN);
+    expect(h.controller.getSnapshot().focus).toBe("ps4");
+  });
+
+  test("OK opens the focused app and a failure reports, bumps and keeps the previous last-used item", () => {
+    const h = harness();
+    h.discover(SIX);
+    h.press(KEY.ENTER);
+    expect(h.launches[0].app.id).toBe("org.tizen.netflix-app");
+    h.controller.leave();
+    h.controller.returnHome();
+    h.press(KEY.RIGHT);
+    h.press(KEY.ENTER);
+    h.launches[1].fail?.();
+    expect(h.toast).toHaveBeenLastCalledWith("Couldn’t open Spotify");
+    expect(h.controller.getSnapshot().bump).toMatchObject({ key: SPOTIFY, kind: "failed" });
+    expect(parseLibrary(h.storage.get(LIBRARY_STORAGE_KEY) ?? null).lastUsed).toBe(NETFLIX);
+    // A late failure from an older launch is ignored.
+    h.press(KEY.ENTER);
+    h.launches[0].fail?.();
+    expect(h.toast).toHaveBeenCalledTimes(1);
+  });
+
+  test("opening darkens the screen first, and a failure or a silent launch gives the Home back", () => {
+    const h = harness({ openMs: OPEN_MS });
+    h.discover(SIX);
+    h.press(KEY.ENTER);
+    expect(h.controller.getSnapshot()).toMatchObject({ curtain: "covering", launching: NETFLIX });
+    expect(h.appsService.launch).not.toHaveBeenCalled();
+    h.press(KEY.RIGHT);
+    expect(h.controller.getSnapshot().focus).toBe(NETFLIX);
+    vi.advanceTimersByTime(OPEN_MS);
+    expect(h.controller.getSnapshot().curtain).toBe("covered");
+    expect(h.appsService.launch).toHaveBeenCalledTimes(1);
+    h.launches[0].fail?.();
+    expect(h.controller.getSnapshot().curtain).toBe("clear");
+    expect(h.toast).toHaveBeenLastCalledWith("Couldn’t open Netflix");
+    h.press(KEY.ENTER);
+    vi.advanceTimersByTime(OPEN_MS);
+    expect(h.controller.getSnapshot().curtain).toBe("covered");
+    vi.advanceTimersByTime(COVERED_LIMIT_MS);
+    expect(h.controller.getSnapshot().curtain).toBe("clear");
+  });
+
+  test("Down from the last row reveals the hidden Apps tile; Up returns to where it came from", () => {
+    const h = harness();
+    h.discover(SIX);
+    h.press(KEY.RIGHT);
+    h.press(KEY.DOWN);
+    expect(h.controller.getSnapshot().focus).toBe("ps4");
+    h.press(KEY.DOWN);
+    expect(h.controller.getSnapshot().focus).toBe("apps");
+    h.press(KEY.RIGHT);
+    expect(h.controller.getSnapshot()).toMatchObject({ focus: "apps", bump: { key: "apps", kind: "right" } });
+    h.press(KEY.DOWN);
+    expect(h.controller.getSnapshot().bump).toMatchObject({ key: "apps", kind: "down" });
+    h.press(KEY.UP);
+    expect(h.controller.getSnapshot().focus).toBe("ps4");
+    h.press(KEY.DOWN);
+    h.press(KEY.ENTER);
+    expect(h.appsService.openStore).toHaveBeenCalledTimes(1);
+  });
+
+  test("with a single full row, Down from any column reveals Apps", () => {
+    const h = harness();
+    h.discover(SIX, []);
+    h.press(KEY.RIGHT);
+    h.press(KEY.RIGHT);
+    h.press(KEY.DOWN);
+    expect(h.controller.getSnapshot().focus).toBe("apps");
+    h.press(KEY.UP);
+    expect(h.controller.getSnapshot().focus).toBe("app:9Ur5IzDKqV.TizenYouTube");
+  });
+
+  test("the Home stays dark while away and fades back in on return, keeping its focus look", () => {
+    const h = harness({ openMs: OPEN_MS });
+    h.discover(SIX);
+    h.press(KEY.ENTER);
+    vi.advanceTimersByTime(OPEN_MS);
+    h.controller.leave();
+    vi.advanceTimersByTime(COVERED_LIMIT_MS);
+    expect(h.controller.getSnapshot()).toMatchObject({ curtain: "covered", focus: NETFLIX });
+    h.controller.returnHome();
+    expect(h.controller.getSnapshot()).toMatchObject({ curtain: "clear", focus: NETFLIX, launching: null });
+  });
+
+  test("the OK click sounds when the button goes down, before the release opens the app", () => {
+    const h = harness();
+    h.discover(SIX);
+    h.sounds.play.mockClear();
+    h.down(KEY.ENTER);
+    expect(h.sounds.play).toHaveBeenCalledWith("select");
+    expect(h.appsService.launch).not.toHaveBeenCalled();
+  });
+
+  test("the sheen shows on the first move after a long pause, and quick arrows switch off animation", () => {
+    const h = harness();
+    h.discover(SIX);
+    h.press(KEY.RIGHT);
+    expect(h.controller.getSnapshot()).toMatchObject({ sheen: SPOTIFY, rapid: false });
+    vi.advanceTimersByTime(400);
+    h.press(KEY.LEFT);
+    expect(h.controller.getSnapshot().sheen).toBeNull();
+    vi.advanceTimersByTime(80);
+    h.press(KEY.RIGHT);
+    expect(h.controller.getSnapshot().rapid).toBe(true);
+    vi.advanceTimersByTime(300);
+    expect(h.controller.getSnapshot().rapid).toBe(false);
+    vi.advanceTimersByTime(150_000);
+    h.press(KEY.LEFT);
+    expect(h.controller.getSnapshot().sheen).toBe(NETFLIX);
+  });
+
+  test("holding OK opens Move and Hide without launching; the held press cannot choose", () => {
+    const h = harness();
+    h.discover(SIX);
+    h.hold(KEY.ENTER);
+    expect(h.appsService.launch).not.toHaveBeenCalled();
+    expect(h.controller.getSnapshot().menu).toEqual({ key: NETFLIX, selected: 0 });
+    expect(h.sounds.play).toHaveBeenLastCalledWith("grab");
+    h.press(KEY.BACK);
+    expect(h.controller.getSnapshot().menu).toBeNull();
+  });
+
+  test("Move swaps with neighbouring apps; Back cancels and OK places", () => {
+    const h = harness();
+    h.discover(SIX);
+    h.hold(KEY.ENTER);
+    h.press(KEY.ENTER);
+    expect(h.controller.getSnapshot().moving).toBe(NETFLIX);
+    h.press(KEY.RIGHT);
+    expect(h.keys().slice(0, 2)).toEqual([SPOTIFY, NETFLIX]);
+    h.press(KEY.DOWN);
+    expect(h.controller.getSnapshot().bump).toMatchObject({ key: NETFLIX, kind: "down" });
+    h.press(KEY.BACK);
+    expect(h.keys().slice(0, 2)).toEqual([NETFLIX, SPOTIFY]);
+    expect(h.controller.getSnapshot().moving).toBeNull();
+    h.hold(KEY.ENTER);
+    h.press(KEY.ENTER);
+    h.press(KEY.RIGHT);
+    h.press(KEY.ENTER);
+    expect(parseLibrary(h.storage.get(LIBRARY_STORAGE_KEY) ?? null).order.slice(0, 2)).toEqual([
+      "rJeHak5zRg.Spotify",
+      "org.tizen.netflix-app",
+    ]);
+  });
+
+  test("an app discovered during a move survives placing the tile", () => {
+    const h = harness();
+    h.discover(SIX);
+    h.hold(KEY.ENTER);
+    h.press(KEY.ENTER);
+    h.discover([...SIX, { id: "later", name: "Twitch", icon: "" }]);
+    expect(h.keys()).toContain("app:later");
+    h.press(KEY.RIGHT);
+    h.press(KEY.ENTER);
+    expect(h.keys()).toContain("app:later");
+    expect(parseLibrary(h.storage.get(LIBRARY_STORAGE_KEY) ?? null).order).toContain("later");
+  });
+
+  test("Hide removes the tile and keeps focus in place", () => {
+    const h = harness();
+    h.discover(SIX);
+    h.hold(KEY.ENTER);
+    h.press(KEY.DOWN);
+    h.press(KEY.ENTER);
+    expect(h.keys()).not.toContain(NETFLIX);
+    expect(h.controller.getSnapshot().focus).toBe(SPOTIFY);
+    expect(h.toast).toHaveBeenLastCalledWith("Netflix hidden");
+  });
+
+  test("holding Back on the Home asks to switch the sound engine; a short Back does nothing", () => {
+    const onBackHold = vi.fn();
+    const h = harness({ onBackHold });
+    h.discover(SIX);
+    h.press(KEY.BACK);
+    vi.advanceTimersByTime(BACK_HOLD_MS);
+    expect(onBackHold).not.toHaveBeenCalled();
+    h.down(KEY.BACK);
+    vi.advanceTimersByTime(BACK_HOLD_MS);
+    expect(onBackHold).toHaveBeenCalledTimes(1);
+  });
+
+  test("holding OK on a fixed tile only says it has a fixed place", () => {
+    const h = harness();
+    h.discover(SIX);
+    h.press(KEY.DOWN);
+    h.hold(KEY.ENTER);
+    expect(h.toast).toHaveBeenLastCalledWith("PS4 has a fixed place");
+    expect(h.controller.getSnapshot().menu).toBeNull();
+    expect(h.show).not.toHaveBeenCalled();
+  });
+
+  test("an OK during the entrance runs when it ends; a hold does not launch", () => {
+    const h = harness({ entranceMs: ENTRANCE_MS });
+    h.discover(SIX);
+    h.press(KEY.ENTER);
+    expect(h.appsService.launch).not.toHaveBeenCalled();
+    vi.advanceTimersByTime(ENTRANCE_MS);
+    expect(h.appsService.launch).toHaveBeenCalledTimes(1);
+    const late = harness({ entranceMs: ENTRANCE_MS });
+    late.discover(SIX);
+    late.hold(KEY.ENTER);
+    vi.advanceTimersByTime(ENTRANCE_MS);
+    expect(late.appsService.launch).not.toHaveBeenCalled();
+  });
+
+  test("returning focuses the last-used item, or the first tile when the PS4 is gone", () => {
+    const h = harness();
+    h.discover(SIX);
+    h.press(KEY.DOWN);
+    h.press(KEY.ENTER);
+    expect(h.show).toHaveBeenCalledWith(PS4);
+    h.press(KEY.RIGHT);
+    h.controller.leave();
+    h.controller.returnHome();
+    expect(h.controller.getSnapshot().focus).toBe("ps4");
+    h.inputs.set({ ...h.inputs.getSnapshot(), sources: [{ ...PS4, connected: false }] });
+    h.controller.returnHome();
+    expect(h.controller.getSnapshot().focus).toBe(NETFLIX);
+  });
+
+  test("a PS4 that disconnects while focused hands focus to the first tile", () => {
+    const h = harness();
+    h.discover(SIX);
+    h.press(KEY.DOWN);
+    expect(h.controller.getSnapshot().focus).toBe("ps4");
+    h.inputs.set({ ...h.inputs.getSnapshot(), sources: [{ ...PS4, connected: false }] });
+    expect(h.controller.getSnapshot().focus).toBe(NETFLIX);
+  });
+
+  test("power-on waits for the last-used tile until the user navigates", () => {
+    const stored = JSON.stringify({
+      initialized: true,
+      known: [],
+      hidden: [],
+      order: ["org.tizen.netflix-app"],
+      lastUsed: "ps4",
+    });
+    const h = harness({ stored });
+    expect(h.controller.getSnapshot().focus).toBe(NETFLIX);
+    h.discover(SIX);
+    expect(h.controller.getSnapshot().focus).toBe("ps4");
+  });
+
+  test("an app opened outside the Home becomes last-used without stealing focus after navigation", () => {
+    const h = harness();
+    h.discover(SIX);
+    h.controller.returnHome();
+    const mark = h.controller.navigationMark();
+    h.controller.observeOpened("rJeHak5zRg.Spotify", mark);
+    expect(h.controller.getSnapshot().focus).toBe(SPOTIFY);
+    h.controller.returnHome();
+    const later = h.controller.navigationMark();
+    h.press(KEY.RIGHT);
+    h.controller.observeOpened("org.tizen.netflix-app", later);
+    expect(h.controller.getSnapshot().focus).not.toBe(NETFLIX);
+    expect(parseLibrary(h.storage.get(LIBRARY_STORAGE_KEY) ?? null).lastUsed).toBe(NETFLIX);
+  });
+
+  test("an uninstalled app disappears and returns to its place when reinstalled", () => {
+    const h = harness();
+    h.discover(SIX);
+    h.discover(SIX.filter((app) => app.id !== "rJeHak5zRg.Spotify"));
+    expect(h.keys()).not.toContain(SPOTIFY);
+    h.discover(SIX);
+    expect(h.keys()[1]).toBe(SPOTIFY);
+  });
+});
