@@ -0,0 +1,28 @@
+import type { ItvSound } from "./createItvSounds";
+
+// Samsung's own UI beeps, played by the TV's audio system instead of the browser's. They are fixed
+// sounds, but they skip the web audio pipeline and its latency. Requires the tv.audio privilege.
+type BeepType = "MOVE" | "SELECT" | "BACK" | "WARNING";
+
+export interface TvAudioTizen {
+  tvaudiocontrol?: { playSound(type: BeepType): void };
+}
+
+const BEEPS: Readonly<Record<ItvSound, BeepType>> = {
+  move: "MOVE",
+  bump: "WARNING",
+  select: "SELECT",
+  back: "BACK",
+  grab: "SELECT",
+};
+
+export const createSamsungSounds = (tizen: TvAudioTizen | null | undefined) => ({
+  available: typeof tizen?.tvaudiocontrol?.playSound === "function",
+  play(sound: ItvSound) {
+    try {
+      tizen?.tvaudiocontrol?.playSound(BEEPS[sound]);
+    } catch {
+      // A sound must never interrupt navigation.
+    }
+  },
+});
diff --git a/launcher/src/itv/state/createInputTimings.ts b/launcher/src/itv/state/createInputTimings.ts
new file mode 100644
index 0000000..2f93abe
--- /dev/null
+++ b/launcher/src/itv/state/createInputTimings.ts
@@ -0,0 +1,85 @@
+// Key-to-frame measurements for the TV test, read with `aerotizen inspect launcher` and `itvPerf.report()`.
+// Kept in memory only: nothing is written per key press.
+
+export interface InputTiming {
+  readonly action: string;
+  // From the handler starting to the next painted frame (two animation frames later).
+  readonly frameMs: number | null;
+  // Handler work, including the synchronous render.
+  readonly handlerMs: number;
+  // Time from the key event to its handler starting, when the event time is usable.
+  readonly queuedMs: number | null;
+}
+
+export interface PresentedKey {
+  // From the key event to the frame that showed its result, as the browser reports it (8 ms steps).
+  readonly presentedMs: number;
+  // From the key event to its handler starting.
+  readonly queuedMs: number;
+}
+
+const TIMINGS_KEPT = 60;
+// Event Timing only reports events slower than this.
+const EVENT_THRESHOLD_MS = 16;
+
+type EventTimingEntry = PerformanceEntry & { processingStart?: number };
+const MAX_QUEUED_MS = 2000;
+
+export const createInputTimings = (host: Pick<Window, "requestAnimationFrame"> | null) => {
+  const timings: InputTiming[] = [];
+  const presented: PresentedKey[] = [];
+  let observer: PerformanceObserver | null = null;
+  try {
+    // Event Timing exists on the TV's engine (Chromium 120), not on the Chromium 63 baseline.
+    const Observer = (window as { PerformanceObserver?: typeof PerformanceObserver }).PerformanceObserver;
+    const types = (Observer as { supportedEntryTypes?: readonly string[] } | undefined)?.supportedEntryTypes;
+    if (Observer && types?.includes("event")) {
+      observer = new Observer((list) => {
+        for (const entry of list.getEntries() as EventTimingEntry[]) {
+          if (entry.name !== "keydown") {
+            continue;
+          }
+          presented.push({
+            presentedMs: Math.round(entry.duration),
+            queuedMs: Math.round((entry.processingStart ?? entry.startTime) - entry.startTime),
+          });
+          if (presented.length > TIMINGS_KEPT) {
+            presented.shift();
+          }
+        }
+      });
+      observer.observe({ type: "event", durationThreshold: EVENT_THRESHOLD_MS } as PerformanceObserverInit);
+    }
+  } catch {
+    observer = null;
+  }
+  return {
+    measure(action: string, eventTime: number | undefined, handle: () => void) {
+      const start = performance.now();
+      handle();
+      const handlerMs = Math.round(performance.now() - start);
+      const queued = typeof eventTime === "number" ? Math.round(start - eventTime) : null;
+      const entry: { -readonly [Key in keyof InputTiming]: InputTiming[Key] } = {
+        action,
+        queuedMs: queued !== null && queued >= 0 && queued <= MAX_QUEUED_MS ? queued : null,
+        handlerMs,
+        frameMs: null,
+      };
+      timings.push(entry);
+      if (timings.length > TIMINGS_KEPT) {
+        timings.shift();
+      }
+      host?.requestAnimationFrame(() =>
+        host.requestAnimationFrame(() => {
+          entry.frameMs = Math.round(performance.now() - start);
+        }),
+      );
+    },
+    report: (): readonly InputTiming[] => timings.map((timing) => ({ ...timing })),
+    // Keydowns slower than 16 ms from event to painted frame, from the browser's own Event Timing.
+    presented: (): readonly PresentedKey[] => [...presented],
+    dispose() {
+      observer?.disconnect();
+    },
+  };
+};
