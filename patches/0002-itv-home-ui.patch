+++ b/launcher/src/itv/components/Wallpaper/createGrainTile.ts
@@ -0,0 +1,45 @@
+// A small, seeded noise tile drawn once and repeated over the wallpaper. Light and dark specks with a
+// low alpha dither the gradient so a large panel shows no colour banding. It is a static image with
+// normal blending, so the TV composites it without a blend pass.
+const TILE_PX = 256;
+// Just enough to break up banding; more reads as sand on a large panel.
+const MAX_ALPHA = 0.03;
+const SEED = 0x1f2e3d4c;
+
+// Mulberry32: deterministic noise keeps screenshots and tests stable.
+const random = (seed: number) => {
+  let state = seed;
+  return () => {
+    state = (state + 0x6d2b79f5) | 0;
+    let value = Math.imul(state ^ (state >>> 15), 1 | state);
+    value = (value + Math.imul(value ^ (value >>> 7), 61 | value)) ^ value;
+    return ((value ^ (value >>> 14)) >>> 0) / 4294967296;
+  };
+};
+
+export const createGrainTile = (document: Document): string | null => {
+  try {
+    const canvas = document.createElement("canvas");
+    canvas.width = TILE_PX;
+    canvas.height = TILE_PX;
+    const context = canvas.getContext("2d");
+    if (!context) {
+      return null;
+    }
+    const image = context.createImageData(TILE_PX, TILE_PX);
+    const next = random(SEED);
+    for (let offset = 0; offset < image.data.length; offset += 4) {
+      // Triangular noise centred on zero: as many lightening as darkening specks.
+      const value = next() - next();
+      const level = value > 0 ? 255 : 0;
+      image.data[offset] = level;
+      image.data[offset + 1] = level;
+      image.data[offset + 2] = level;
+      image.data[offset + 3] = Math.round(Math.abs(value) * MAX_ALPHA * 255);
+    }
+    context.putImageData(image, 0, 0);
+    return canvas.toDataURL("image/png");
+  } catch {
+    return null;
+  }
+};
