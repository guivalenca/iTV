@@ -0,0 +1,49 @@
+// The focused tile's deep shadow, drawn once into a bitmap. A blurred box-shadow on a layer that animates
+// can be re-rastered on the TV's CPU at every focus change; a ready image is only composited.
+export const FOCUS_SHADOW = {
+  facePx: { width: 284, height: 170 },
+  radiusPx: 19,
+  offsetYPx: 30,
+  // CSS blur radius 60 px, the prototype's `0 30px 60px rgba(0, 0, 0, 0.6)`.
+  blurPx: 60,
+  colour: "rgba(0, 0, 0, 0.6)",
+  // Room around the face for the blur and the offset.
+  paddingPx: 100,
+} as const;
+
+// The shape is drawn far outside the canvas and only its shadow is shifted in, so the bitmap holds the
+// shadow alone and translucent tiles are not darkened from behind.
+const OFFSCREEN_PX = 10000;
+
+export const createFocusShadow = (document: Document): string | null => {
+  const { facePx, radiusPx, offsetYPx, blurPx, colour, paddingPx } = FOCUS_SHADOW;
+  try {
+    const canvas = document.createElement("canvas");
+    canvas.width = facePx.width + paddingPx * 2;
+    canvas.height = facePx.height + paddingPx * 2;
+    const context = canvas.getContext("2d");
+    if (!context) {
+      return null;
+    }
+    context.shadowColor = colour;
+    context.shadowBlur = blurPx;
+    context.shadowOffsetX = OFFSCREEN_PX;
+    context.shadowOffsetY = offsetYPx;
+    const x = paddingPx - OFFSCREEN_PX;
+    const y = paddingPx;
+    const right = x + facePx.width;
+    const bottom = y + facePx.height;
+    context.beginPath();
+    context.moveTo(x + radiusPx, y);
+    context.arcTo(right, y, right, bottom, radiusPx);
+    context.arcTo(right, bottom, x, bottom, radiusPx);
+    context.arcTo(x, bottom, x, y, radiusPx);
+    context.arcTo(x, y, right, y, radiusPx);
+    context.closePath();
+    context.fillStyle = "#000";
+    context.fill();
+    return canvas.toDataURL("image/png");
+  } catch {
+    return null;
+  }
+};
