+// iTV Home settings that are chosen on the Mac and shipped with the build.
+
+export const WALLPAPERS = {
+  // Purple to orange; the approved wallpaper.
+  dusk: "radial-gradient(120% 90% at 75% 12%, #ff9a62 0%, #c4507a 26%, #4a2a7a 55%, #120f2e 88%)",
+  // Kept in reserve.
+  ocean: "radial-gradient(110% 90% at 20% 8%, #5fd3c6 0%, #1f7a9c 35%, #0d2f5a 65%, #050d1f 100%)",
+} as const;
+
+export type WallpaperName = keyof typeof WALLPAPERS;
+
+export const ITV_CONFIG = {
+  wallpaper: "dusk" as WallpaperName,
+  // HDMI port to treat as the PS4 if the console does not announce a recognisable name. Set after the TV check.
+  ps4FixedPort: null as number | null,
+} as const;
